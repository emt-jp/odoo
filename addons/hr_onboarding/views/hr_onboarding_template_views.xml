<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_onboarding_template_view_form" model="ir.ui.view">
        <field name="name">hr.onboarding.template.form</field>
        <field name="model">hr.onboarding.template</field>
        <field name="arch" type="xml">
            <form string="Onboarding Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="note" placeholder="Template description..."/>
                    <separator string="Checklist Tasks"/>
                    <field name="task_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="department_id"/>
                            <field name="responsible_user_id"/>
                            <field name="days_after_start"/>
                            <field name="description"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_onboarding_template_view_list" model="ir.ui.view">
        <field name="name">hr.onboarding.template.list</field>
        <field name="model">hr.onboarding.template</field>
        <field name="arch" type="xml">
            <list string="Onboarding Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="hr_onboarding_template_action" model="ir.actions.act_window">
        <field name="name">Onboarding Templates</field>
        <field name="res_model">hr.onboarding.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
