<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Form View Extension for T-Number -->
    <record id="view_move_form_t_number" model="ir.ui.view">
        <field name="name">account.move.form.t_number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add T-Number info section -->
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Japanese Invoice System (インボイス制度)"
                       invisible="not is_qualified_invoice">
                    <group>
                        <field name="is_qualified_invoice" readonly="1"/>
                        <field name="issuer_t_number" readonly="1"/>
                        <field name="recipient_t_number" readonly="1"/>
                    </group>
                    <group>
                        <field name="has_multiple_tax_rates" invisible="1"/>
                    </group>
                </group>
                <group string="Tax Breakdown (税額内訳)"
                       invisible="not is_qualified_invoice">
                    <group>
                        <field name="tax_base_reduced" string="8% Tax Base (税抜金額)"/>
                        <field name="tax_amount_reduced" string="8% Tax Amount (消費税額)"/>
                    </group>
                    <group>
                        <field name="tax_base_standard" string="10% Tax Base (税抜金額)"/>
                        <field name="tax_amount_standard" string="10% Tax Amount (消費税額)"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Print Qualified Invoice Action -->
    <record id="action_print_qualified_invoice" model="ir.actions.server">
        <field name="name">Print Qualified Invoice (適格請求書)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
if record.is_qualified_invoice:
    action = record.action_print_qualified_invoice()
else:
    raise UserError('This invoice is not a Qualified Invoice.')
        </field>
    </record>
</odoo>
