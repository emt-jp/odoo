<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget Form View -->
    <record id="view_account_budget_form" model="ir.ui.view">
        <field name="name">account.budget.form</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_validate" type="object" string="Validate"
                            invisible="state != 'confirmed'" class="btn-primary"/>
                    <button name="action_done" type="object" string="Done"
                            invisible="state != 'validated'" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancelled', 'confirmed')"/>
                    <button name="action_compute_actual" type="object" string="Compute Actual"
                            invisible="state == 'draft'" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,validated,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Budget Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <group>
                            <field name="total_planned" widget="monetary"/>
                            <field name="total_actual" widget="monetary"/>
                        </group>
                        <group>
                            <field name="total_variance" widget="monetary"/>
                            <field name="variance_percentage" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Lines" name="budget_lines">
                            <field name="budget_line_ids">
                                <list editable="bottom">
                                    <field name="account_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="planned_amount" widget="monetary"/>
                                    <field name="actual_amount" widget="monetary"/>
                                    <field name="variance" widget="monetary"/>
                                    <field name="variance_percentage" widget="percentage"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Budget Tree View -->
    <record id="view_account_budget_tree" model="ir.ui.view">
        <field name="name">account.budget.tree</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets" decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_planned" widget="monetary"/>
                <field name="total_actual" widget="monetary"/>
                <field name="variance_percentage" widget="percentage"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state in ('validated', 'done')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Budget Search View -->
    <record id="view_account_budget_search" model="ir.ui.view">
        <field name="name">account.budget.search</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <search string="Search Budgets">
                <field name="name"/>
                <field name="user_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="My Budgets" name="my_budgets" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Start Date" name="group_date_from" context="{'group_by': 'date_from:month'}"/>
            </search>
        </field>
    </record>

    <!-- Budget Action -->
    <record id="action_account_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">account.budget</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_budgets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first budget
            </p>
            <p>
                Plan and track your financial budgets by account and analytic account.
            </p>
        </field>
    </record>

    <!-- Budget Line Tree View (for separate list if needed) -->
    <record id="view_account_budget_line_tree" model="ir.ui.view">
        <field name="name">account.budget.line.tree</field>
        <field name="model">account.budget.line</field>
        <field name="arch" type="xml">
            <list string="Budget Lines">
                <field name="budget_id"/>
                <field name="account_id"/>
                <field name="analytic_account_id"/>
                <field name="planned_amount" widget="monetary"/>
                <field name="actual_amount" widget="monetary"/>
                <field name="variance" widget="monetary"/>
                <field name="variance_percentage" widget="percentage"/>
            </list>
        </field>
    </record>
</odoo>
