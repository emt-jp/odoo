<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company Form Extension for Payment Settings and Hanko -->
    <record id="view_company_form_payment" model="ir.ui.view">
        <field name="name">res.company.form.payment</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Hanko &amp; Payments" name="hanko_payments">
                    <!-- Hanko Section -->
                    <group string="Company Seal (会社印/Hanko)">
                        <group>
                            <field name="hanko_image" widget="image" class="oe_avatar"/>
                            <field name="hanko_image_filename" invisible="1"/>
                        </group>
                        <group>
                            <p class="text-muted">
                                Upload your company seal (Hanko) image.
                                This will appear on receipts for paid invoices.
                                Recommended size: 100x100 pixels, PNG format with transparency.
                            </p>
                        </group>
                    </group>

                    <!-- Online Payment Settings -->
                    <group string="Online Payment Settings">
                        <field name="enable_online_payment"/>
                    </group>

                    <!-- Stripe Settings -->
                    <group string="Stripe Configuration" invisible="not enable_online_payment">
                        <group>
                            <field name="stripe_enabled"/>
                            <field name="stripe_publishable_key"
                                   invisible="not stripe_enabled"
                                   password="True"/>
                            <field name="stripe_secret_key"
                                   invisible="not stripe_enabled"
                                   password="True"/>
                        </group>
                        <group>
                            <field name="stripe_webhook_secret"
                                   invisible="not stripe_enabled"
                                   password="True"/>
                            <div invisible="not stripe_enabled" class="text-muted small">
                                Webhook URL: /payment/stripe/webhook
                            </div>
                        </group>
                    </group>

                    <!-- PayPay Settings -->
                    <group string="PayPay Configuration" invisible="not enable_online_payment">
                        <group>
                            <field name="paypay_enabled"/>
                            <field name="paypay_merchant_id"
                                   invisible="not paypay_enabled"/>
                            <field name="paypay_api_key"
                                   invisible="not paypay_enabled"
                                   password="True"/>
                        </group>
                        <group>
                            <field name="paypay_api_secret"
                                   invisible="not paypay_enabled"
                                   password="True"/>
                            <field name="paypay_production"
                                   invisible="not paypay_enabled"/>
                            <div invisible="not paypay_enabled" class="text-muted small">
                                Webhook URL: /payment/paypay/webhook
                            </div>
                        </group>
                    </group>

                    <!-- AirPay Settings -->
                    <group string="AirPay Configuration" invisible="not enable_online_payment">
                        <group>
                            <field name="airpay_enabled"/>
                            <field name="airpay_merchant_id"
                                   invisible="not airpay_enabled"/>
                            <field name="airpay_api_key"
                                   invisible="not airpay_enabled"
                                   password="True"/>
                        </group>
                        <group>
                            <field name="airpay_api_secret"
                                   invisible="not airpay_enabled"
                                   password="True"/>
                            <div invisible="not airpay_enabled" class="text-muted small">
                                Webhook URL: /payment/airpay/webhook
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Invoice Form Extension for Payment Links -->
    <record id="view_move_form_payment" model="ir.ui.view">
        <field name="name">account.move.form.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_payment_links"
                        type="object"
                        string="Generate Payment Links"
                        class="btn-secondary"
                        invisible="state != 'posted' or payment_state == 'paid' or not has_online_payment or move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_send_payment_link"
                        type="object"
                        string="Send Payment Link"
                        class="btn-secondary"
                        invisible="state != 'posted' or payment_state == 'paid' or not has_online_payment or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Online Payments" invisible="not has_online_payment or move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <field name="payment_link_stripe" widget="url"
                               readonly="1" invisible="not payment_link_stripe"/>
                        <field name="payment_link_paypay" widget="url"
                               readonly="1" invisible="not payment_link_paypay"/>
                        <field name="payment_link_airpay" widget="url"
                               readonly="1" invisible="not payment_link_airpay"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Payment Transaction Tree View -->
    <record id="view_payment_transaction_tree" model="ir.ui.view">
        <field name="name">payment.transaction.custom.tree</field>
        <field name="model">payment.transaction.custom</field>
        <field name="arch" type="xml">
            <list string="Payment Transactions">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="amount" widget="monetary"/>
                <field name="provider"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'done'"
                       decoration-danger="state in ('cancelled', 'error')"/>
                <field name="payment_date"/>
                <field name="provider_reference"/>
            </list>
        </field>
    </record>

    <!-- Payment Transaction Form View -->
    <record id="view_payment_transaction_form" model="ir.ui.view">
        <field name="name">payment.transaction.custom.form</field>
        <field name="model">payment.transaction.custom</field>
        <field name="arch" type="xml">
            <form string="Payment Transaction">
                <header>
                    <button name="action_generate_payment_link"
                            type="object"
                            string="Generate Payment Link"
                            invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_confirm_payment"
                            type="object"
                            string="Confirm Payment"
                            invisible="state != 'pending'"
                            class="btn-success"
                            groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="invoice_id"/>
                            <field name="partner_id"/>
                            <field name="amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="provider"/>
                            <field name="provider_reference"/>
                            <field name="payment_url" widget="url"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message"/>
                    </group>
                    <group invisible="not webhook_data">
                        <field name="webhook_data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Payment Transaction Action -->
    <record id="action_payment_transaction" model="ir.actions.act_window">
        <field name="name">Payment Transactions</field>
        <field name="res_model">payment.transaction.custom</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Email Template for Payment Link -->
    <record id="email_template_payment_link" model="mail.template">
        <field name="name">Invoice: Payment Link</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">{{ object.company_id.name }}: Payment for Invoice {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <p>Dear <t t-out="object.partner_id.name"/>,</p>

    <p>Please find below the payment options for invoice <strong><t t-out="object.name"/></strong>.</p>

    <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Invoice Number:</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.name"/></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Amount Due:</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="format_amount(object.amount_residual, object.currency_id)"/></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Due Date:</strong></td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.invoice_date_due"/></td>
        </tr>
    </table>

    <h3>Payment Options:</h3>

    <t t-if="object.payment_link_stripe">
        <p>
            <a t-att-href="object.payment_link_stripe" style="display: inline-block; padding: 10px 20px; background-color: #635bff; color: white; text-decoration: none; border-radius: 5px;">
                Pay with Card (Stripe)
            </a>
        </p>
    </t>

    <t t-if="object.payment_link_paypay">
        <p>
            <a t-att-href="object.payment_link_paypay" style="display: inline-block; padding: 10px 20px; background-color: #ff0033; color: white; text-decoration: none; border-radius: 5px;">
                Pay with PayPay
            </a>
        </p>
    </t>

    <p style="margin-top: 30px;">
        Thank you for your business!<br/>
        ご利用ありがとうございます。
    </p>

    <p>
        Best regards,<br/>
        <t t-out="object.company_id.name"/>
    </p>
</div>
        </field>
    </record>
</odoo>
