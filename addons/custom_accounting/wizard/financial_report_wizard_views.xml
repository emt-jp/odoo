<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Financial Report Wizard Form View -->
    <record id="view_financial_report_wizard_form" model="ir.ui.view">
        <field name="name">financial.report.wizard.form</field>
        <field name="model">financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Financial Report">
                <group>
                    <group string="Report Settings">
                        <field name="report_type"/>
                        <field name="output_format"/>
                    </group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group string="Filters" col="4">
                    <field name="account_ids" widget="many2many_tags"/>
                    <field name="partner_ids" widget="many2many_tags"/>
                    <field name="analytic_account_ids" widget="many2many_tags"/>
                </group>
                <group string="Display Options" col="4">
                    <field name="show_zero_balance"/>
                    <field name="hierarchy"/>
                </group>
                <group string="Comparison" col="4">
                    <field name="enable_comparison"/>
                    <field name="comparison_date_from" invisible="not enable_comparison"/>
                    <field name="comparison_date_to" invisible="not enable_comparison"/>
                </group>
                <footer>
                    <button name="action_generate_report" type="object"
                            string="Generate Report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Financial Report Wizard Action -->
    <record id="action_financial_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Financial Report</field>
        <field name="res_model">financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Account Move Reject Wizard Form View -->
    <record id="view_account_move_reject_wizard_form" model="ir.ui.view">
        <field name="name">account.move.reject.wizard.form</field>
        <field name="model">account.move.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Journal Entry">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="Enter reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
