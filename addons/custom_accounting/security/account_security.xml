<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Budget Manager Group -->
        <record id="group_budget_manager" model="res.groups">
            <field name="name">Budget Manager</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>

        <!-- Multi-company rules -->
        <record id="budget_company_rule" model="ir.rule">
            <field name="name">Budget multi-company</field>
            <field name="model_id" ref="model_account_budget"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="budget_line_company_rule" model="ir.rule">
            <field name="name">Budget Line multi-company</field>
            <field name="model_id" ref="model_account_budget_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="financial_report_company_rule" model="ir.rule">
            <field name="name">Financial Report multi-company</field>
            <field name="model_id" ref="model_account_financial_report_custom"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="financial_dashboard_company_rule" model="ir.rule">
            <field name="name">Financial Dashboard multi-company</field>
            <field name="model_id" ref="model_account_financial_dashboard"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="aging_report_company_rule" model="ir.rule">
            <field name="name">Aging Report multi-company</field>
            <field name="model_id" ref="model_account_aging_report"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
