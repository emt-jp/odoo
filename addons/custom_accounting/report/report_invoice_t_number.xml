<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_qis_document" inherit_id="account.report_invoice_document" primary="True">



        <xpath expr="//div[hasclass('invoice_main')]" position="before">
            <style type="text/css">
                /* ── Unified 8px body, 9px header/footer ── */
                .page { font-size: 8px; line-height: 1.3; }

                /* Header */
                .company_address { font-size: 9px !important; line-height: 1.3 !important; }
                .company_address img { max-height: 40px !important; }
                .oe_structure { display: none; }

                /* Title bar */
                h2 {
                    font-size: 14px !important; margin: 2px 0 !important;
                    padding: 3px 8px !important; background: #f5f5f5 !important;
                    border-left: 3px solid #495057 !important;
                }

                /* Registration number */
                .qis-reg { display: inline-block; border-left: 2px solid #495057;
                    padding: 1px 0 1px 6px; margin: 2px 0 1px; }
                .qis-reg-label { font-size: 6px; color: #6c757d; text-transform: uppercase;
                    letter-spacing: 0.3px; line-height: 1; margin-bottom: 0; }
                .qis-reg-value { font-size: 8px; font-weight: 600;
                    font-family: "Courier New", monospace; letter-spacing: 0.6px; }

                /* Informations row */
                #informations { margin-bottom: 2px !important; padding: 1px 0 !important; font-size: 8px; }
                #informations .col { padding-bottom: 0 !important; }
                #informations strong { font-size: 7px; color: #6c757d; text-transform: uppercase; }

                /* Line items */
                table.o_main_table { margin-bottom: 0 !important; }
                table.o_main_table thead th {
                    padding: 2px 4px !important; font-size: 7px !important;
                    text-transform: uppercase; letter-spacing: 0.2px; color: #495057;
                    border-bottom: 1.5px solid #495057 !important;
                }
                table.o_main_table tbody td {
                    padding: 3px 4px !important; font-size: 8px !important;
                    line-height: 1.3 !important; vertical-align: top;
                }

                /* Totals */
                #total { margin-top: 0 !important; }
                #total table td, #total table th {
                    padding: 2px 4px !important; font-size: 8px !important;
                }

                /* Tax breakdown */
                .qis-breakdown { width: auto !important; margin-bottom: 0; }
                .qis-breakdown thead th {
                    font-size: 7px; text-transform: uppercase; color: #495057; font-weight: 600;
                    border-top: none !important; border-bottom: 1px solid #495057 !important;
                    padding: 1px 4px; background: none !important; white-space: nowrap;
                }
                .qis-breakdown .qis-bkdn-title th {
                    font-size: 7px; text-transform: none; color: #212529;
                    border-bottom: none !important; padding-bottom: 0;
                }
                .qis-breakdown tbody td {
                    padding: 1px 4px; font-size: 8px;
                    border-top: none !important; border-bottom: 1px solid #e9ecef !important;
                }
                .qis-breakdown tbody td:first-child { color: #495057; }
                .qis-breakdown tbody tr:last-child td { border-bottom: 1px solid #495057 !important; }

                .qis-mark { color: #495057; }
                .qis-legend { font-size: 7px; color: #6c757d; padding: 0; }

                /* Bank details — single row */
                .qis-bank-row {
                    margin-top: 4px; padding: 3px 6px; background: #f8f9fa;
                    border: 1px solid #dee2e6; border-radius: 2px;
                    font-size: 8px; line-height: 1.4; color: #212529;
                }
                .qis-bank-row strong { font-weight: 600; }
                .qis-bank-row .sep { color: #ccc; margin: 0 3px; }

                /* Compliance */
                .qis-compliance {
                    padding-top: 2px; margin-top: 2px;
                    font-size: 7px; color: #6c757d; line-height: 1.3;
                }
                .qis-compliance p { margin-bottom: 0; }

                .qis-sub { font-size: 0.55em; color: #6c757d; font-weight: normal; margin-left: 2px; }

                /* ── Header: logo beside company, customer top-right ── */
                header { padding-bottom: 0 !important; margin-bottom: 0 !important; }
                header .d-flex.justify-content-between {
                    position: absolute; left: 0; top: 0; z-index: 2;
                }
                .o_company_logo_small {
                    max-height: 32px !important; margin-bottom: 0 !important;
                }
                header .o_company_tagline { display: none !important; }
                header &gt; .row { margin-top: 0 !important; }
                header div[name="company_address"] {
                    padding-left: 48px !important;
                    font-size: 8px !important; line-height: 1.2 !important;
                }
                header div[name="company_address"] ul { margin-bottom: 0 !important; }
                /* Customer address — top right */
                .address.row { margin-top: -4px !important; margin-bottom: 2px !important; }
                .address .ms-auto, .address .offset-col-6,
                .address div[name="no_shipping"],
                .address div[name="address_same_as_shipping"],
                .address div[name="address_not_same_as_shipping"] {
                    text-align: right !important; font-size: 9px !important;
                }
            </style>
        </xpath>

        <!-- Bilingual titles -->
        <xpath expr="//t[@name='invoice_title']" position="replace">
            <t name="invoice_title">請求書 <span class="qis-sub">Invoice</span></t>
        </xpath>
        <xpath expr="//t[@name='draft_invoice_title']" position="replace">
            <t name="draft_invoice_title">請求書（下書き） <span class="qis-sub">Draft Invoice</span></t>
        </xpath>
        <xpath expr="//t[@name='cancelled_invoice_title']" position="replace">
            <t name="cancelled_invoice_title">請求書（取消） <span class="qis-sub">Cancelled Invoice</span></t>
        </xpath>
        <xpath expr="//t[@name='credit_note_title']" position="replace">
            <t name="credit_note_title">クレジットノート <span class="qis-sub">Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='draft_credit_note_title']" position="replace">
            <t name="draft_credit_note_title">クレジットノート（下書き） <span class="qis-sub">Draft Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='cancelled_credit_note_title']" position="replace">
            <t name="cancelled_credit_note_title">クレジットノート（取消） <span class="qis-sub">Cancelled Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='proforma_invoice_title']" position="replace">
            <t name="proforma_invoice_title">見積請求書 <span class="qis-sub">Proforma Invoice</span></t>
        </xpath>
        <xpath expr="//t[@name='draft_proforma_invoice_title']" position="replace">
            <t name="draft_proforma_invoice_title">見積請求書（下書き） <span class="qis-sub">Draft Proforma</span></t>
        </xpath>
        <xpath expr="//t[@name='cancelled_proforma_invoice_title']" position="replace">
            <t name="cancelled_proforma_invoice_title">見積請求書（取消） <span class="qis-sub">Cancelled Proforma</span></t>
        </xpath>
        <xpath expr="//t[@name='proforma_credit_note_title']" position="replace">
            <t name="proforma_credit_note_title">クレジットノート <span class="qis-sub">Proforma Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='draft_proforma_credit_note_title']" position="replace">
            <t name="draft_proforma_credit_note_title">クレジットノート（下書き） <span class="qis-sub">Draft Proforma Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='cancelled_proforma_credit_note_title']" position="replace">
            <t name="cancelled_proforma_credit_note_title">クレジットノート（取消） <span class="qis-sub">Cancelled Proforma Credit Note</span></t>
        </xpath>

        <!-- Registration number -->
        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="o.issuer_t_number" class="qis-reg">
                <div class="qis-reg-label">登録番号 Registration No.</div>
                <div class="qis-reg-value"><span t-field="o.issuer_t_number"/></div>
            </div>
        </xpath>

        <!-- Reduced-rate marker -->
        <xpath expr="//td[@name='account_invoice_line_name']/span[@t-field='line.name']" position="after">
            <span t-if="line.is_reduced_tax_rate" class="qis-mark"> ※</span>
        </xpath>

        <!-- Reduced-rate legend -->
        <xpath expr="//div[hasclass('overflow-hidden')]" position="before">
            <div t-if="o.tax_base_reduced" class="qis-legend">
                ※ 軽減税率対象品目 / Items subject to reduced tax rate
            </div>
        </xpath>

        <!-- Tax breakdown -->
        <xpath expr="//div[@id='payment_term']" position="before">
            <div t-if="o.is_qualified_invoice and (o.tax_base_standard or o.tax_base_reduced)" class="clearfix avoid-page-break-inside mb-0">
                <div class="float-end">
                    <table class="qis-breakdown table table-sm table-borderless">
                        <thead>
                            <tr class="qis-bkdn-title"><th colspan="3">税額内訳 Tax Breakdown</th></tr>
                            <tr><th>税率</th><th class="text-end">税抜金額</th><th class="text-end">消費税額</th></tr>
                        </thead>
                        <tbody>
                            <tr t-if="o.tax_base_standard">
                                <td>10% 標準</td>
                                <td class="text-end"><span t-field="o.tax_base_standard"/></td>
                                <td class="text-end"><span t-field="o.tax_amount_standard"/></td>
                            </tr>
                            <tr t-if="o.tax_base_reduced">
                                <td>8% 軽減 ※</td>
                                <td class="text-end"><span t-field="o.tax_base_reduced"/></td>
                                <td class="text-end"><span t-field="o.tax_amount_reduced"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>

        <!-- Remove payment_term -->
        <xpath expr="//div[@id='payment_term']" position="replace"/>

        <!-- Bank details (single row) + Stripe + Compliance — after totals -->
        <xpath expr="//div[@id='total']" position="after">
            <div t-if="o.partner_bank_id and o.move_type in ('out_invoice', 'out_refund')" class="qis-bank-row avoid-page-break-inside">
                <strong>お振込先:</strong>
                <span t-field="o.partner_bank_id.bank_id.name"/>
                <span class="sep">|</span>
                <span t-field="o.partner_bank_id.bank_id.street"/>
                <span class="sep">|</span>
                <span t-field="o.partner_bank_id.bank_id.street2"/>
                <span class="sep">|</span>
                口座 <span t-field="o.partner_bank_id.acc_number"/>
                <span class="sep">|</span>
                <span t-field="o.partner_bank_id.acc_holder_name"/>
                <t t-if="o.stripe_payment_link_url">
                    <span class="sep">|</span>
                    💳 <a t-att-href="o.stripe_payment_link_url" style="color:#0d6efd; font-size:7px;" t-esc="o.stripe_payment_link_url"/>
                </t>
            </div>
            <div t-if="o.is_qualified_invoice" class="qis-compliance">
                <p>※ 適格請求書（インボイス）消費税法準拠 / Qualified Invoice per JP Consumption Tax Act</p>
            </div>
        </xpath>

    
    
    </template>

    <template id="report_invoice_qis" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-call='account.report_invoice_document']" position="after">
            <t t-if="o._get_name_invoice_report() == 'custom_accounting.report_invoice_qis_document'"
               t-call="custom_accounting.report_invoice_qis_document" t-lang="lang"/>
        </xpath>
    </template>

    <template id="report_invoice_t_number">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="custom_accounting.report_invoice_qis_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_invoice_t_number" model="ir.actions.report">
        <field name="name">Qualified Invoice (適格請求書)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_accounting.report_invoice_t_number</field>
        <field name="report_file">custom_accounting.report_invoice_t_number</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
