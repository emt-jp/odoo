<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        QIS Invoice Document Template
        ─────────────────────────────
        Inherits ALL standard Odoo invoice features (payment QR codes, payment terms,
        grouped/collapsed lines, discount columns, etc.) via primary="True" inheritance.
        Adds Japanese Qualified Invoice System (適格請求書) elements via XPath.
        Only used when company.use_japanese_invoice_system is True.
    -->
    <template id="report_invoice_qis_document" inherit_id="account.report_invoice_document" primary="True">

        <!-- ============================================================ -->
        <!-- QIS stylesheet — follows Odoo report design tokens           -->
        <!--   Gray scale: #f8f9fa → #212529                             -->
        <!--   Borders: #dee2e6 (light), #ced4da (mid), #495057 (dark)   -->
        <!--   Base font: 13px, line-height 1.3                          -->
        <!-- ============================================================ -->
        <xpath expr="//div[hasclass('invoice_main')]" position="before">
            <style type="text/css">
                /* Registration number block */
                .qis-reg {
                    border-left: 3px solid #495057;
                    padding: 3px 0 3px 10px;
                    margin-bottom: 10px;
                }
                .qis-reg-label {
                    font-size: 8px;
                    color: #6c757d;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    line-height: 1.2;
                    margin-bottom: 1px;
                }
                .qis-reg-value {
                    font-size: 13px;
                    font-weight: 600;
                    font-family: 'Courier New', Courier, monospace;
                    letter-spacing: 1px;
                    color: #212529;
                }

                /* Reduced-rate marker */
                .qis-mark { color: #495057; }

                /* Footnote legend */
                .qis-legend {
                    font-size: 9px;
                    color: #6c757d;
                    padding: 2px 0 6px;
                    letter-spacing: 0.2px;
                }

                /* Tax breakdown table */
                .qis-breakdown { width: auto !important; margin-bottom: 8px; }
                .qis-breakdown thead th {
                    font-size: 8px;
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                    color: #495057;
                    font-weight: 600;
                    border-top: none !important;
                    border-bottom: 1.5px solid #495057 !important;
                    padding: 3px 10px;
                    background: none !important;
                    white-space: nowrap;
                }
                .qis-breakdown .qis-bkdn-title th {
                    font-size: 10px;
                    text-transform: none;
                    letter-spacing: 0;
                    color: #212529;
                    border-bottom: none !important;
                    padding-bottom: 1px;
                }
                .qis-breakdown tbody td {
                    padding: 3px 10px;
                    font-size: 10px;
                    border-top: none !important;
                    border-bottom: 1px solid #e9ecef !important;
                }
                .qis-breakdown tbody td:first-child { color: #495057; }
                .qis-breakdown tbody tr:last-child td {
                    border-bottom: 1.5px solid #495057 !important;
                }

                /* Compliance footer */
                .qis-compliance {
                    border-top: 1px solid #dee2e6;
                    padding-top: 8px;
                    margin-top: 12px;
                    font-size: 8px;
                    color: #6c757d;
                    line-height: 1.6;
                }
                .qis-compliance p { margin-bottom: 0; }

                /* Bilingual subtitle text */
                .qis-sub {
                    font-size: 0.6em;
                    color: #6c757d;
                    font-weight: normal;
                    margin-left: 2px;
                }
            </style>
        </xpath>

        <!-- ============================================================ -->
        <!-- 1. Bilingual invoice titles — JP primary, EN secondary       -->
        <!-- ============================================================ -->
        <xpath expr="//t[@name='invoice_title']" position="replace">
            <t name="invoice_title">請求書 <span class="qis-sub">Invoice</span></t>
        </xpath>
        <xpath expr="//t[@name='draft_invoice_title']" position="replace">
            <t name="draft_invoice_title">請求書（下書き） <span class="qis-sub">Draft Invoice</span></t>
        </xpath>
        <xpath expr="//t[@name='cancelled_invoice_title']" position="replace">
            <t name="cancelled_invoice_title">請求書（取消） <span class="qis-sub">Cancelled Invoice</span></t>
        </xpath>
        <xpath expr="//t[@name='credit_note_title']" position="replace">
            <t name="credit_note_title">クレジットノート <span class="qis-sub">Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='draft_credit_note_title']" position="replace">
            <t name="draft_credit_note_title">クレジットノート（下書き） <span class="qis-sub">Draft Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='cancelled_credit_note_title']" position="replace">
            <t name="cancelled_credit_note_title">クレジットノート（取消） <span class="qis-sub">Cancelled Credit Note</span></t>
        </xpath>

        <!-- Proforma titles -->
        <xpath expr="//t[@name='proforma_invoice_title']" position="replace">
            <t name="proforma_invoice_title">見積請求書 <span class="qis-sub">Proforma Invoice</span></t>
        </xpath>
        <xpath expr="//t[@name='draft_proforma_invoice_title']" position="replace">
            <t name="draft_proforma_invoice_title">見積請求書（下書き） <span class="qis-sub">Draft Proforma</span></t>
        </xpath>
        <xpath expr="//t[@name='cancelled_proforma_invoice_title']" position="replace">
            <t name="cancelled_proforma_invoice_title">見積請求書（取消） <span class="qis-sub">Cancelled Proforma</span></t>
        </xpath>
        <xpath expr="//t[@name='proforma_credit_note_title']" position="replace">
            <t name="proforma_credit_note_title">クレジットノート <span class="qis-sub">Proforma Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='draft_proforma_credit_note_title']" position="replace">
            <t name="draft_proforma_credit_note_title">クレジットノート（下書き） <span class="qis-sub">Draft Proforma Credit Note</span></t>
        </xpath>
        <xpath expr="//t[@name='cancelled_proforma_credit_note_title']" position="replace">
            <t name="cancelled_proforma_credit_note_title">クレジットノート（取消） <span class="qis-sub">Cancelled Proforma Credit Note</span></t>
        </xpath>

        <!-- ============================================================ -->
        <!-- 2. Issuer registration number — left-accent block            -->
        <!-- ============================================================ -->
        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="o.issuer_t_number" class="qis-reg">
                <div class="qis-reg-label">登録番号 / Registration No.</div>
                <div class="qis-reg-value"><span t-field="o.issuer_t_number"/></div>
            </div>
        </xpath>

        <!-- ============================================================ -->
        <!-- 3. ※ reduced-rate marker — subtle inline indicator           -->
        <!-- ============================================================ -->
        <xpath expr="//td[@name='account_invoice_line_name']/span[@t-field='line.name']" position="after">
            <span t-if="line.is_reduced_tax_rate" class="qis-mark"> ※</span>
        </xpath>

        <!-- ============================================================ -->
        <!-- 4. Reduced-rate legend — footnote before totals              -->
        <!-- ============================================================ -->
        <xpath expr="//div[hasclass('overflow-hidden')]" position="before">
            <div t-if="o.tax_base_reduced" class="qis-legend">
                ※ 軽減税率対象品目 / Items subject to reduced tax rate
            </div>
        </xpath>

        <!-- ============================================================ -->
        <!-- 5. QIS tax breakdown — right-aligned, after totals           -->
        <!-- ============================================================ -->
        <xpath expr="//div[@id='payment_term']" position="before">
            <div t-if="o.is_qualified_invoice and (o.tax_base_standard or o.tax_base_reduced)"
                 class="clearfix avoid-page-break-inside mb-2">
                <div class="float-end">
                    <table class="qis-breakdown table table-sm table-borderless">
                        <thead>
                            <tr class="qis-bkdn-title">
                                <th colspan="3">税額内訳 / Tax Breakdown</th>
                            </tr>
                            <tr>
                                <th>税率 / Rate</th>
                                <th class="text-end">税抜金額 / Base</th>
                                <th class="text-end">消費税額 / Tax</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="o.tax_base_standard">
                                <td>10%　標準税率</td>
                                <td class="text-end"><span t-field="o.tax_base_standard"/></td>
                                <td class="text-end"><span t-field="o.tax_amount_standard"/></td>
                            </tr>
                            <tr t-if="o.tax_base_reduced">
                                <td>8%　軽減税率 ※</td>
                                <td class="text-end"><span t-field="o.tax_base_reduced"/></td>
                                <td class="text-end"><span t-field="o.tax_amount_reduced"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>

        <!-- ============================================================ -->
        <!-- 6. QIS compliance notice — subtle footer                     -->
        <!-- ============================================================ -->
        <xpath expr="//div[@id='payment_term']" position="inside">
            <div t-if="o.is_qualified_invoice" class="qis-compliance">
                <p>※ この請求書は、消費税法に基づく適格請求書（インボイス）です。</p>
                <p>This is a Qualified Invoice under the Japanese Consumption Tax Act.</p>
            </div>
        </xpath>

    </template>

    <!-- ================================================================ -->
    <!-- Extend standard report_invoice to dispatch to QIS template       -->
    <!-- ================================================================ -->
    <template id="report_invoice_qis" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-call='account.report_invoice_document']" position="after">
            <t t-if="o._get_name_invoice_report() == 'custom_accounting.report_invoice_qis_document'"
               t-call="custom_accounting.report_invoice_qis_document"
               t-lang="lang"/>
        </xpath>
    </template>

    <!-- ================================================================ -->
    <!-- Wrapper for explicit "Print Qualified Invoice" button            -->
    <!-- ================================================================ -->
    <template id="report_invoice_t_number">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="custom_accounting.report_invoice_qis_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- ================================================================ -->
    <!-- Report action for explicit "Print Qualified Invoice" button      -->
    <!-- ================================================================ -->
    <record id="action_report_invoice_t_number" model="ir.actions.report">
        <field name="name">Qualified Invoice (適格請求書)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_accounting.report_invoice_t_number</field>
        <field name="report_file">custom_accounting.report_invoice_t_number</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
