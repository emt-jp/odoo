<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_hanko" model="ir.ui.view">
        <field name="name">res.company.form.hanko</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Invoice Seal" name="invoice_hanko">
                    <group>
                        <group string="Company Seal (Hanko / 角印)">
                            <field name="invoice_hanko" widget="image"
                                   class="oe_avatar"
                                   options="{'size': [128, 128]}"/>
                        </group>
                        <group string="Display">
                            <field name="invoice_hanko_show"/>
                            <field name="invoice_hanko_width"
                                   invisible="not invoice_hanko_show"/>
                            <field name="invoice_hanko_opacity"
                                   invisible="not invoice_hanko_show"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Upload a transparent PNG of the company seal. It is
                        stamped over the totals block on invoice PDFs. A hanko
                        is customary, not legally required — make sure the
                        qualified-invoice registration number is also on the
                        invoice.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
