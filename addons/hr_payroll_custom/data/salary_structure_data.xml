<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Salary Rule Categories -->
        <record id="category_basic" model="hr.salary.rule.category">
            <field name="name">Basic</field>
            <field name="code">BASIC</field>
            <field name="sequence">1</field>
        </record>

        <record id="category_earning" model="hr.salary.rule.category">
            <field name="name">Earnings</field>
            <field name="code">EARNING</field>
            <field name="sequence">10</field>
        </record>

        <record id="category_deduction" model="hr.salary.rule.category">
            <field name="name">Deductions</field>
            <field name="code">DEDUCTION</field>
            <field name="sequence">20</field>
        </record>

        <record id="category_net" model="hr.salary.rule.category">
            <field name="name">Net Salary</field>
            <field name="code">NET</field>
            <field name="sequence">30</field>
        </record>

        <!-- Default Salary Structure -->
        <record id="structure_default" model="hr.salary.structure">
            <field name="name">Standard Salary Structure</field>
            <field name="is_default" eval="True"/>
        </record>

    </data>
</odoo>
