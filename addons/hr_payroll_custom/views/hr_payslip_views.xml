<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.form</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <form string="Payslip">
                <header>
                    <button name="action_compute_sheet" string="Compute Sheet" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_payslip_verify" string="Submit for Approval" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_payslip_done" string="Approve" type="object" invisible="state != 'verify'" class="oe_highlight" groups="hr_payroll_custom.group_hr_payroll_manager"/>
                    <button name="action_payslip_cancel" string="Reject" type="object" invisible="state not in ['draft', 'verify']"/>
                    <button name="action_payslip_draft" string="Set to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verify,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="contract_id"/>
                            <field name="struct_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="number"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Salary Computation">
                            <field name="line_ids">
                                <list editable="bottom" decoration-info="category_id.code == 'EARNING'" decoration-danger="category_id.code == 'DEDUCTION'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category_id"/>
                                    <field name="rate"/>
                                    <field name="quantity"/>
                                    <field name="total" sum="Total"/>
                                    <field name="salary_rule_id" invisible="1"/>
                                    <field name="employee_id" invisible="1"/>
                                    <field name="contract_id" invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="basic_wage"/>
                                <field name="gross_wage"/>
                                <field name="total_deductions"/>
                                <field name="net_wage" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hr_payslip_list" model="ir.ui.view">
        <field name="name">hr.payslip.tree</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <list string="Payslips" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="number"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="gross_wage"/>
                <field name="net_wage"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'" decoration-warning="state == 'verify'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_hr_payslip" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_hr_payroll_payslips" name="Payslips" parent="menu_hr_payroll_root" action="action_hr_payslip" sequence="10"/>
</odoo>
