<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" style="font-family: 'Helvetica Neue', Arial, sans-serif; color: #333; padding: 20px;">

                    <!-- Header -->
                    <div style="display: table; width: 100%; margin-bottom: 20px;">
                        <div style="display: table-cell; vertical-align: top; width: 60%;">
                            <h2 style="color: #e74c3c; margin: 0 0 5px 0; font-size: 22px;">
                                <span t-esc="o.company_id.name"/>
                            </h2>
                            <div style="font-size: 11px; color: #666;">
                                <t t-if="o.company_id.street"><span t-esc="o.company_id.street"/>, </t>
                                <t t-if="o.company_id.street2"><span t-esc="o.company_id.street2"/>, </t>
                                <t t-if="o.company_id.city"><span t-esc="o.company_id.city"/>, </t>
                                <t t-if="o.company_id.state_id"><span t-esc="o.company_id.state_id.name"/>, </t>
                                <t t-if="o.company_id.zip"><span t-esc="o.company_id.zip"/></t>
                            </div>
                        </div>
                        <div style="display: table-cell; vertical-align: top; text-align: right;">
                            <div style="background: #f8f9fa; border-radius: 8px; padding: 12px 20px; display: inline-block;">
                                <div style="font-size: 16px; font-weight: bold;">
                                    Payslip: <span t-field="o.date_from" t-options='{"widget": "date", "format": "MMMM yyyy"}'/>
                                </div>
                                <div style="font-size: 10px; color: #888; margin-top: 4px;">
                                    Ref: <span t-esc="o.number"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Net Pay Summary -->
                    <div style="background: #f8f9fa; border-radius: 10px; padding: 20px; margin-bottom: 25px;">
                        <table style="width: 100%; text-align: center;">
                            <tr>
                                <td style="width: 33%;">
                                    <div style="font-size: 12px; color: #666;">Net Pay</div>
                                    <div style="font-size: 26px; font-weight: bold; color: #2c3e50;">
                                        <t t-foreach="o.line_ids" t-as="nl">
                                            <t t-if="nl.code == 'NET'">
                                                &#8377; <span t-esc="'{:,.0f}'.format(nl.total)"/>
                                            </t>
                                        </t>
                                    </div>
                                </td>
                                <td style="font-size: 20px; color: #999;">=</td>
                                <td style="width: 28%;">
                                    <div style="font-size: 12px; color: #666;">Gross Pay (A)</div>
                                    <div style="font-size: 17px; font-weight: 600; color: #27ae60;">
                                        <t t-foreach="o.line_ids" t-as="gl">
                                            <t t-if="gl.code == 'GROSS'">
                                                + <span t-esc="'{:,.0f}'.format(gl.total)"/>
                                            </t>
                                        </t>
                                    </div>
                                </td>
                                <td style="font-size: 20px; color: #999;">-</td>
                                <td style="width: 28%;">
                                    <div style="font-size: 12px; color: #666;">Deductions (B)</div>
                                    <div style="font-size: 17px; font-weight: 600; color: #e74c3c;">
                                        - <span t-esc="'{:,.0f}'.format(o.total_deductions)"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Employee Details -->
                    <div style="margin-bottom: 25px;">
                        <table style="width: 100%; font-size: 12px;">
                            <tr>
                                <td style="width: 50%; vertical-align: top; padding-right: 20px;">
                                    <table style="width: 100%;">
                                        <tr><td style="color: #888; padding: 2px 0;">Employee Code</td></tr>
                                        <tr><td style="font-weight: 600; padding: 0 0 6px 0;"><span t-esc="o.number"/></td></tr>
                                        <tr><td style="color: #888; padding: 2px 0;">Name</td></tr>
                                        <tr><td style="font-weight: 600; padding: 0 0 6px 0;"><span t-esc="o.employee_id.name"/></td></tr>
                                        <tr><td style="color: #888; padding: 2px 0;">Designation</td></tr>
                                        <tr><td style="font-weight: 600; padding: 0 0 6px 0;"><span t-esc="o.employee_id.job_title or '-'"/></td></tr>
                                        <tr><td style="color: #888; padding: 2px 0;">Department</td></tr>
                                        <tr><td style="font-weight: 600; padding: 0 0 6px 0;"><span t-esc="o.employee_id.department_id.name or '-'"/></td></tr>
                                    </table>
                                </td>
                                <td style="width: 50%; vertical-align: top;">
                                    <table style="width: 100%;">
                                        <tr><td style="color: #888; padding: 2px 0;">Date of Birth</td></tr>
                                        <tr><td style="font-weight: 600; padding: 0 0 6px 0;"><span t-field="o.employee_id.birthday"/></td></tr>
                                        <tr><td style="color: #888; padding: 2px 0;">PAN</td></tr>
                                        <tr><td style="font-weight: 600; padding: 0 0 6px 0;"><span t-esc="o.employee_id.identification_id or '-'"/></td></tr>
                                        <tr><td style="color: #888; padding: 2px 0;">Pay Period</td></tr>
                                        <tr><td style="font-weight: 600; padding: 0 0 6px 0;">
                                            <span t-field="o.date_from"/> to <span t-field="o.date_to"/>
                                        </td></tr>
                                        <tr><td style="color: #888; padding: 2px 0;">Tax Regime</td></tr>
                                        <tr><td style="font-weight: 600; padding: 0 0 6px 0;"><span t-field="o.contract_id.tax_regime"/></td></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Earnings Section -->
                    <div style="margin-bottom: 25px;">
                        <div style="margin-bottom: 8px;">
                            <span style="display: inline-block; width: 10px; height: 10px; background: #27ae60; border-radius: 50; margin-right: 6px; vertical-align: middle;"/>
                            <span style="font-size: 14px; font-weight: 600;">Gross Pay (A)</span>
                            <span style="font-size: 11px; color: #888; margin-left: 8px;">The total money you earned before the deductions</span>
                        </div>
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f8f9fa;">
                                    <th style="text-align: left; padding: 8px 12px; font-size: 12px; color: #666;">Earnings</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Monthly</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-if="line.category_id.code in ('BASIC', 'EARNING') and line.code != 'GROSS'">
                                        <tr style="border-bottom: 1px solid #f0f0f0;">
                                            <td style="padding: 8px 12px; font-size: 13px;"><span t-esc="line.name"/></td>
                                            <td style="text-align: right; padding: 8px 12px; font-size: 13px;"><span t-esc="'{:,.0f}'.format(line.total)"/></td>
                                            <td style="text-align: right; padding: 8px 12px; font-size: 13px;"><span t-esc="'{:,.0f}'.format(line.total)"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background: #f8f9fa; border-top: 2px solid #e0e0e0;">
                                    <td style="padding: 8px 12px; font-size: 13px; font-weight: 700;">Gross Pay</td>
                                    <td/>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px; font-weight: 700;">
                                        <t t-foreach="o.line_ids" t-as="gline">
                                            <t t-if="gline.code == 'GROSS'"><span t-esc="'{:,.0f}'.format(gline.total)"/></t>
                                        </t>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Deductions Section -->
                    <div style="margin-bottom: 25px;">
                        <div style="margin-bottom: 8px;">
                            <span style="display: inline-block; width: 10px; height: 10px; background: #e74c3c; border-radius: 50; margin-right: 6px; vertical-align: middle;"/>
                            <span style="font-size: 14px; font-weight: 600;">Deductions (B)</span>
                            <span style="font-size: 11px; color: #888; margin-left: 8px;">The amount deducted for taxes and other benefits</span>
                        </div>
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f8f9fa;">
                                    <th style="text-align: left; padding: 8px 12px; font-size: 12px; color: #666;">Deductions</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Monthly</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="dline">
                                    <t t-if="dline.category_id.code == 'DEDUCTION'">
                                        <tr style="border-bottom: 1px solid #f0f0f0;">
                                            <td style="padding: 8px 12px; font-size: 13px;"><span t-esc="dline.name"/></td>
                                            <td style="text-align: right; padding: 8px 12px; font-size: 13px;"><span t-esc="'{:,.0f}'.format(dline.total)"/></td>
                                            <td style="text-align: right; padding: 8px 12px; font-size: 13px;"><span t-esc="'{:,.0f}'.format(dline.total)"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background: #f8f9fa; border-top: 2px solid #e0e0e0;">
                                    <td style="padding: 8px 12px; font-size: 13px; font-weight: 700;">Total Deductions</td>
                                    <td/>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px; font-weight: 700;">
                                        <span t-esc="'{:,.0f}'.format(o.total_deductions)"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Yearly Taxable Income -->
                    <div style="margin-bottom: 25px;">
                        <div style="margin-bottom: 8px;">
                            <span style="display: inline-block; width: 10px; height: 10px; background: #3498db; border-radius: 50; margin-right: 6px; vertical-align: middle;"/>
                            <span style="font-size: 14px; font-weight: 600;">Yearly Taxable Income (C)</span>
                        </div>
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f8f9fa;">
                                    <th style="text-align: left; padding: 8px 12px; font-size: 12px; color: #666;">Description</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Annual</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Taxable</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="aline">
                                    <t t-if="aline.category_id.code in ('BASIC', 'EARNING') and aline.code != 'GROSS'">
                                        <tr style="border-bottom: 1px solid #f0f0f0;">
                                            <td style="padding: 8px 12px; font-size: 13px;"><span t-esc="aline.name"/></td>
                                            <td style="text-align: right; padding: 8px 12px; font-size: 13px;"><span t-esc="'{:,.0f}'.format(aline.total * 12)"/></td>
                                            <td style="text-align: right; padding: 8px 12px; font-size: 13px;"><span t-esc="'{:,.0f}'.format(aline.total * 12)"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background: #f8f9fa; border-top: 2px solid #e0e0e0;">
                                    <td style="padding: 8px 12px; font-size: 13px; font-weight: 700;">Annual Taxable Salary</td>
                                    <td/>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px; font-weight: 700;">
                                        <t t-foreach="o.line_ids" t-as="gtline">
                                            <t t-if="gtline.code == 'GROSS'"><span t-esc="'{:,.0f}'.format(gtline.total * 12)"/></t>
                                        </t>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Net Taxable Income (E) -->
                    <div style="margin-bottom: 25px;">
                        <div style="margin-bottom: 8px;">
                            <span style="display: inline-block; width: 10px; height: 10px; background: #9b59b6; border-radius: 50; margin-right: 6px; vertical-align: middle;"/>
                            <span style="font-size: 14px; font-weight: 600;">Net Taxable Income (D)</span>
                            <span style="font-size: 11px; color: #888; margin-left: 8px;">Your taxes are calculated on this Net Taxable Income</span>
                        </div>
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f8f9fa;">
                                    <th style="text-align: left; padding: 8px 12px; font-size: 12px; color: #666;">Details</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <td style="padding: 8px 12px; font-size: 13px;">Annual Taxable Salary (C)</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px;">
                                        <t t-foreach="o.line_ids" t-as="gs1">
                                            <t t-if="gs1.code == 'GROSS'"><span t-esc="'{:,.0f}'.format(gs1.total * 12)"/></t>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <td style="padding: 8px 12px; font-size: 13px;">Standard Deductions (Section 16)</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px;">-75,000</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="background: #f8f9fa; border-top: 2px solid #e0e0e0;">
                                    <td style="padding: 8px 12px; font-size: 13px; font-weight: 700;">Net Taxable Income</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px; font-weight: 700;">
                                        <t t-foreach="o.line_ids" t-as="gs2">
                                            <t t-if="gs2.code == 'GROSS'"><span t-esc="'{:,.0f}'.format(gs2.total * 12 - 75000)"/></t>
                                        </t>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Tax Computation -->
                    <div style="margin-bottom: 25px;">
                        <div style="margin-bottom: 8px;">
                            <span style="display: inline-block; width: 10px; height: 10px; background: #e67e22; border-radius: 50; margin-right: 6px; vertical-align: middle;"/>
                            <span style="font-size: 14px; font-weight: 600;">Tax for FY 2025-26</span>
                            <span style="font-size: 11px; color: #888; margin-left: 8px;">Tax will be deducted on this Net Taxable Income after all exemptions</span>
                        </div>
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f8f9fa;">
                                    <th style="text-align: left; padding: 8px 12px; font-size: 12px; color: #666;">Details</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- New Tax Regime slab calculation for FY 2025-26 -->
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <td style="padding: 8px 12px; font-size: 13px;">Tax on Taxable Income</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px;">
                                        <t t-foreach="o.line_ids" t-as="tx1">
                                            <t t-if="tx1.code == 'TAX'"><span t-esc="'{:,.0f}'.format(tx1.total * 12 / 1.04)"/></t>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <td style="padding: 8px 12px; font-size: 13px;">Education Cess (4%)</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px;">
                                        <t t-foreach="o.line_ids" t-as="tx2">
                                            <t t-if="tx2.code == 'TAX'"><span t-esc="'{:,.0f}'.format(tx2.total * 12 - tx2.total * 12 / 1.04)"/></t>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <td style="padding: 8px 12px; font-size: 13px; font-weight: 600;">Net Tax</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px; font-weight: 600;">
                                        <t t-foreach="o.line_ids" t-as="tx3">
                                            <t t-if="tx3.code == 'TAX'"><span t-esc="'{:,.0f}'.format(tx3.total * 12)"/></t>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <td style="padding: 8px 12px; font-size: 13px;">Tax Deducted Till Date (Current Employer)</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px;">
                                        <t t-foreach="o.line_ids" t-as="tx4">
                                            <t t-if="tx4.code == 'TAX'"><span t-esc="'{:,.0f}'.format(tx4.total)"/></t>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="background: #f8f9fa; border-top: 2px solid #e0e0e0;">
                                    <td style="padding: 8px 12px; font-size: 13px; font-weight: 700;">Tax To Be Deducted This Year</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px; font-weight: 700;">
                                        <t t-foreach="o.line_ids" t-as="tx5">
                                            <t t-if="tx5.code == 'TAX'"><span t-esc="'{:,.0f}'.format(tx5.total * 12 - tx5.total)"/></t>
                                        </t>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Tax for This Month -->
                    <div style="margin-bottom: 25px;">
                        <div style="margin-bottom: 8px;">
                            <span style="display: inline-block; width: 10px; height: 10px; background: #e67e22; border-radius: 50; margin-right: 6px; vertical-align: middle;"/>
                            <span style="font-size: 14px; font-weight: 600;">Tax for <span t-field="o.date_from" t-options='{"widget": "date", "format": "MMMM yyyy"}'/></span>
                        </div>
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #f8f9fa;">
                                    <th style="text-align: left; padding: 8px 12px; font-size: 12px; color: #666;">Details</th>
                                    <th style="text-align: right; padding: 8px 12px; font-size: 12px; color: #666;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <td style="padding: 8px 12px; font-size: 13px;">Tax to be deducted this month</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px;">
                                        <t t-foreach="o.line_ids" t-as="tm1">
                                            <t t-if="tm1.code == 'TAX'"><span t-esc="'{:,.0f}'.format(tm1.total)"/></t>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="background: #f8f9fa; border-top: 2px solid #e0e0e0;">
                                    <td style="padding: 8px 12px; font-size: 13px; font-weight: 700;">Tax Deducted This Month</td>
                                    <td style="text-align: right; padding: 8px 12px; font-size: 13px; font-weight: 700;">
                                        <t t-foreach="o.line_ids" t-as="tm2">
                                            <t t-if="tm2.code == 'TAX'"><span t-esc="'{:,.0f}'.format(tm2.total)"/></t>
                                        </t>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Monthly TDS Projection -->
                    <div style="margin-bottom: 25px;">
                        <div style="margin-bottom: 8px;">
                            <span style="display: inline-block; width: 10px; height: 10px; background: #7f8c8d; border-radius: 50; margin-right: 6px; vertical-align: middle;"/>
                            <span style="font-size: 14px; font-weight: 600;">Monthly Tax</span>
                            <span style="font-size: 11px; color: #888; margin-left: 8px;">Projected TDS for rest of the year are marked with *</span>
                        </div>
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                            <tr>
                                <t t-set="fy_months" t-value="['April', 'May', 'June', 'July', 'August', 'September']"/>
                                <t t-foreach="fy_months" t-as="m">
                                    <td style="padding: 8px; text-align: center; border: 1px solid #f0f0f0;">
                                        <div style="color: #888; font-size: 11px;"><span t-esc="m"/> *</div>
                                        <div style="font-weight: 600; margin-top: 2px;">
                                            <t t-foreach="o.line_ids" t-as="mp1">
                                                <t t-if="mp1.code == 'TAX'"><span t-esc="'{:,.0f}'.format(mp1.total)"/></t>
                                            </t>
                                        </div>
                                    </td>
                                </t>
                            </tr>
                            <tr>
                                <t t-set="fy_months2" t-value="['October', 'November', 'December', 'January', 'February', 'March']"/>
                                <t t-foreach="fy_months2" t-as="m2">
                                    <td style="padding: 8px; text-align: center; border: 1px solid #f0f0f0;">
                                        <div style="color: #888; font-size: 11px;"><span t-esc="m2"/> *</div>
                                        <div style="font-weight: 600; margin-top: 2px;">
                                            <t t-foreach="o.line_ids" t-as="mp2">
                                                <t t-if="mp2.code == 'TAX'"><span t-esc="'{:,.0f}'.format(mp2.total)"/></t>
                                            </t>
                                        </div>
                                    </td>
                                </t>
                            </tr>
                        </table>
                        <div style="font-size: 10px; color: #999; margin-top: 6px;">* These may change if there is a change in your income</div>
                    </div>

                    <!-- Net Pay Footer -->
                    <div style="background: #27ae60; border-radius: 10px; padding: 18px; color: white; text-align: center;">
                        <div style="font-size: 12px; opacity: 0.9;">Net Pay for <span t-field="o.date_from" t-options='{"widget": "date", "format": "MMMM yyyy"}'/></div>
                        <div style="font-size: 28px; font-weight: bold; margin-top: 4px;">
                            <t t-foreach="o.line_ids" t-as="nfl">
                                <t t-if="nfl.code == 'NET'">
                                    &#8377; <span t-esc="'{:,.0f}'.format(nfl.total)"/>
                                </t>
                            </t>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div style="margin-top: 25px; text-align: center; font-size: 10px; color: #999; border-top: 1px solid #eee; padding-top: 12px;">
                        This is a computer generated payslip and does not require a signature
                    </div>
                </div>

                <t t-if="not o_last">
                    <div style="page-break-after: always;"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
