<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Order Kanban View -->
    <record id="view_restaurant_order_kanban" model="ir.ui.view">
        <field name="name">restaurant.order.kanban</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="table_id"/>
                <field name="order_type"/>
                <field name="state"/>
                <field name="total_amount"/>
                <field name="waiter_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="table_id"/> - <field name="order_type"/>
                                        </div>
                                    </div>
                                    <span t-attf-class="badge badge-pill badge-#{record.state.raw_value}">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        Total: <strong><field name="total_amount"/> <field name="currency_id" invisible="1"/></strong>
                                    </div>
                                    <div>
                                        Waiter: <field name="waiter_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Order List View -->
    <record id="view_restaurant_order_list" model="ir.ui.view">
        <field name="name">restaurant.order.list</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <list string="Orders" decoration-success="state == 'paid'"
                  decoration-info="state in ('preparing', 'ready')"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="order_date"/>
                <field name="table_id" optional="show"/>
                <field name="order_type" widget="badge" optional="show"/>
                <field name="waiter_id" optional="hide"/>
                <field name="guest_count" optional="hide"/>
                <field name="state" widget="badge" optional="show"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('confirmed', 'preparing')"
                       decoration-success="state in ('served', 'done', 'paid')"
                       decoration-warning="state == 'ready'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="total_amount" widget="monetary"/>
                <field name="payment_status" widget="badge" optional="hide"
                       decoration-success="payment_status == 'paid'"
                       decoration-warning="payment_status == 'partial'"
                       decoration-danger="payment_status == 'unpaid'"/>
            </list>
        </field>
    </record>

    <!-- Order Form View -->
    <record id="view_restaurant_order_form" model="ir.ui.view">
        <field name="name">restaurant.order.form</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <form string="Restaurant Order">
                <header>
                    <button name="action_confirm" string="Confirm Order" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_send_to_kitchen" string="Send to Kitchen" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_mark_ready" string="Mark Ready" type="object"
                            class="oe_highlight" invisible="state != 'preparing'"/>
                    <button name="action_mark_served" string="Mark Served" type="object"
                            class="oe_highlight" invisible="state != 'ready'"/>
                    <button name="action_mark_done" string="Mark Done" type="object"
                            invisible="state != 'served'"/>
                    <button name="action_process_payment" string="Process Payment" type="object"
                            class="oe_highlight" invisible="state != 'done'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,preparing,ready,served,done,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="order_type"/>
                            <field name="table_id" invisible="order_type != 'dine_in'"/>
                            <field name="floor_id" invisible="order_type != 'dine_in'"/>
                            <field name="waiter_id"/>
                        </group>
                        <group>
                            <field name="order_date"/>
                            <field name="guest_count"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>

                    <group string="👤 Customer Information">
                        <group>
                            <field name="customer_id"/>
                            <field name="customer_name"/>
                        </group>
                        <group>
                            <field name="customer_phone"/>
                            <field name="delivery_address" invisible="order_type != 'delivery'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="menu_item_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="state" widget="badge" optional="hide"/>
                                    <field name="notes" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="subtotal" widget="monetary"/>
                                <field name="tax_amount" widget="monetary"/>
                                <field name="discount_amount" widget="monetary"/>
                                <field name="discount_percent"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="total_amount"/>
                                    <field name="total_amount" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                                </div>
                            </group>
                        </page>

                        <page string="Payment">
                            <group>
                                <group>
                                    <field name="payment_method"/>
                                    <field name="payment_status" widget="badge"/>
                                </group>
                                <group>
                                    <field name="paid_amount" widget="monetary"/>
                                    <field name="invoice_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Timing">
                            <group>
                                <group>
                                    <field name="kitchen_time"/>
                                    <field name="ready_time"/>
                                    <field name="served_time"/>
                                </group>
                                <group>
                                    <field name="closed_time"/>
                                    <field name="preparation_time"/>
                                    <field name="actual_prep_time"/>
                                </group>
                            </group>
                        </page>

                        <page string="Special Instructions">
                            <field name="notes" placeholder="Special instructions for the order..."/>
                        </page>
                    </notebook>

                    <field name="currency_id" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Order Action -->
    <record id="action_restaurant_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">restaurant.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- Order Search View -->
    <record id="view_restaurant_order_search" model="ir.ui.view">
        <field name="name">restaurant.order.search</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <search string="Search Orders">
                <field name="name"/>
                <field name="table_id"/>
                <field name="customer_name"/>
                <filter string="Today" name="today" domain="[('order_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Active" name="active" domain="[('state', 'in', ('confirmed', 'preparing', 'ready', 'served'))]"/>
                <filter string="Dine In" name="dine_in" domain="[('order_type', '=', 'dine_in')]"/>
                <filter string="Takeout" name="takeout" domain="[('order_type', '=', 'takeout')]"/>
                <filter string="Delivery" name="delivery" domain="[('order_type', '=', 'delivery')]"/>
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Order Type" name="group_by_type" context="{'group_by': 'order_type'}"/>
                    <filter string="Table" name="group_by_table" context="{'group_by': 'table_id'}"/>
                    <filter string="Waiter" name="group_by_waiter" context="{'group_by': 'waiter_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
