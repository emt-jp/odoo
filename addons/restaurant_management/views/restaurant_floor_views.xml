<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Floor List View -->
    <record id="view_restaurant_floor_list" model="ir.ui.view">
        <field name="name">restaurant.floor.list</field>
        <field name="model">restaurant.floor</field>
        <field name="arch" type="xml">
            <list string="Floors">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="table_count"/>
                <field name="available_tables" decoration-success="available_tables &gt; 0"/>
                <field name="occupied_tables" decoration-danger="occupied_tables &gt; 0"/>
                <field name="reserved_tables" decoration-warning="reserved_tables &gt; 0"/>
                <field name="total_capacity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Floor Form View -->
    <record id="view_restaurant_floor_form" model="ir.ui.view">
        <field name="name">restaurant.floor.form</field>
        <field name="model">restaurant.floor</field>
        <field name="arch" type="xml">
            <form string="Restaurant Floor">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Floor Name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="table_count"/>
                            <field name="total_capacity"/>
                        </group>
                    </group>

                    <group string="📊 Current Status">
                        <group>
                            <field name="available_tables"/>
                            <field name="occupied_tables"/>
                        </group>
                        <group>
                            <field name="reserved_tables"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Tables">
                            <field name="table_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="capacity"/>
                                    <field name="status" widget="badge"/>
                                    <field name="current_order_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Floor Action -->
    <record id="action_restaurant_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">restaurant.floor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
