<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kitchen Display Kanban View -->
    <record id="view_kitchen_display_kanban" model="ir.ui.view">
        <field name="name">restaurant.order.kitchen.kanban</field>
        <field name="model">restaurant.order</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" create="false">
                <field name="name"/>
                <field name="table_id"/>
                <field name="order_type"/>
                <field name="state"/>
                <field name="kitchen_time"/>
                <field name="preparation_time"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.priority.raw_value == '1' ? 'border-danger' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title" style="font-size: 18px;">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="table_id"/> - <field name="order_type"/>
                                        </div>
                                    </div>
                                    <div>
                                        <span t-if="record.priority.raw_value == '1'" class="badge badge-danger">URGENT</span>
                                        <span t-attf-class="badge badge-pill badge-#{record.state.raw_value}">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body mt-2">
                                    <field name="line_ids">
                                        <list>
                                            <field name="menu_item_id"/>
                                            <field name="quantity"/>
                                            <field name="notes"/>
                                        </list>
                                    </field>
                                    <div class="mt-2">
                                        <small>Prep Time: <field name="preparation_time"/> min</small>
                                    </div>
                                    <div t-if="record.kitchen_time.raw_value">
                                        <small>In kitchen: <field name="kitchen_time"/></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Kitchen Display Action -->
    <record id="action_kitchen_display" model="ir.actions.act_window">
        <field name="name">Kitchen Display</field>
        <field name="res_model">restaurant.order</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_kitchen_display_kanban"/>
        <field name="domain">[('state', 'in', ('confirmed', 'preparing', 'ready'))]</field>
        <field name="context">{'search_default_kitchen': 1, 'create': False}</field>
    </record>
</odoo>
