<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Table Kanban View -->
    <record id="view_restaurant_table_kanban" model="ir.ui.view">
        <field name="name">restaurant.table.kanban</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="capacity"/>
                <field name="status"/>
                <field name="floor_id"/>
                <field name="current_order_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            Table <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="floor_id"/>
                                        </div>
                                    </div>
                                    <span t-attf-class="badge badge-pill badge-#{record.status.raw_value}">
                                        <field name="status"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        Capacity: <field name="capacity"/> guests
                                    </div>
                                    <div t-if="record.current_order_id.raw_value">
                                        Order: <field name="current_order_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Table List View -->
    <record id="view_restaurant_table_list" model="ir.ui.view">
        <field name="name">restaurant.table.list</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <list string="Tables" decoration-success="status == 'available'"
                  decoration-danger="status == 'occupied'"
                  decoration-warning="status == 'reserved'"
                  decoration-info="status == 'cleaning'">
                <field name="name"/>
                <field name="floor_id"/>
                <field name="capacity"/>
                <field name="status" widget="badge" optional="show"
                       decoration-success="status == 'available'"
                       decoration-danger="status == 'occupied'"
                       decoration-warning="status == 'reserved'"
                       decoration-info="status == 'cleaning'"
                       decoration-muted="status == 'maintenance'"/>
                <field name="current_order_id" optional="show"/>
                <field name="total_orders" optional="hide"/>
                <field name="total_revenue" optional="hide" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Table Form View -->
    <record id="view_restaurant_table_form" model="ir.ui.view">
        <field name="name">restaurant.table.form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form string="Restaurant Table">
                <header>
                    <button name="action_set_available" string="Set Available" type="object"
                            class="oe_highlight" invisible="status == 'available'"/>
                    <button name="action_set_occupied" string="Set Occupied" type="object"
                            invisible="status == 'occupied'"/>
                    <button name="action_set_cleaning" string="Set Cleaning" type="object"
                            invisible="status == 'cleaning'"/>
                    <field name="status" widget="statusbar" statusbar_visible="available,occupied,reserved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Table Number"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="floor_id"/>
                            <field name="capacity"/>
                            <field name="shape"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="current_order_id"/>
                        </group>
                    </group>

                    <group string="📊 Statistics">
                        <group>
                            <field name="total_orders"/>
                            <field name="total_revenue" widget="monetary"/>
                        </group>
                        <group>
                            <field name="position_x" groups="base.group_no_one"/>
                            <field name="position_y" groups="base.group_no_one"/>
                        </group>
                    </group>

                    <field name="notes" placeholder="Table notes..."/>
                    <field name="currency_id" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Table Action -->
    <record id="action_restaurant_table" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
