<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User Groups -->
    <record id="group_restaurant_waiter" model="res.groups">
        <field name="name">Restaurant / Waiter</field>
    </record>

    <record id="group_restaurant_manager" model="res.groups">
        <field name="name">Restaurant / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_restaurant_waiter'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="restaurant_order_waiter_rule" model="ir.rule">
        <field name="name">Waiter: See Own Orders</field>
        <field name="model_id" ref="model_restaurant_order"/>
        <field name="domain_force">[('waiter_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_restaurant_waiter'))]"/>
    </record>

    <record id="restaurant_order_manager_rule" model="ir.rule">
        <field name="name">Manager: See All Orders</field>
        <field name="model_id" ref="model_restaurant_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_restaurant_manager'))]"/>
    </record>
</odoo>
