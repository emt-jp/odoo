<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Employee Form View - Driver Information -->
        <record id="view_employee_form_driver" model="ir.ui.view">
            <field name="name">hr.employee.form.driver</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Driver Information" groups="hr.group_hr_user">
                        <group>
                            <group string="Driver Details">
                                <field name="is_driver"/>
                                <field name="driver_license_number" invisible="not is_driver" required="is_driver"/>
                                <field name="driver_license_type" invisible="not is_driver" required="is_driver"/>
                                <field name="driver_license_issue_date" invisible="not is_driver"/>
                                <field name="driver_license_expiry_date" invisible="not is_driver"/>
                                <field name="driver_license_state" invisible="not is_driver" widget="badge"
                                       decoration-success="driver_license_state == 'valid'"
                                       decoration-warning="driver_license_state == 'expiring_soon'"
                                       decoration-danger="driver_license_state in ['expired', 'suspended', 'revoked']"/>
                            </group>
                            <group string="Status" invisible="not is_driver">
                                <field name="is_available_for_driving"/>
                                <field name="current_driving_status" widget="badge"
                                       decoration-success="current_driving_status == 'available'"
                                       decoration-info="current_driving_status == 'on_trip'"
                                       decoration-warning="current_driving_status == 'on_leave'"
                                       decoration-muted="current_driving_status == 'not_available'"/>
                            </group>
                        </group>
                        <group string="Statistics" invisible="not is_driver">
                            <group>
                                <field name="total_trips"/>
                                <field name="total_distance_driven"/>
                            </group>
                            <group>
                                <field name="average_trip_rating" widget="priority"/>
                            </group>
                        </group>
                        <group string="Bookings" invisible="not is_driver">
                            <field name="assigned_booking_ids" nolabel="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Employee Tree View - Add Driver Fields -->
        <record id="view_employee_tree_driver" model="ir.ui.view">
            <field name="name">hr.employee.tree.driver</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="is_driver" optional="hide"/>
                    <field name="driver_license_number" optional="hide"/>
                    <field name="current_driving_status" string="Driving Status" optional="show" widget="badge"
                           decoration-success="current_driving_status == 'available'"
                           decoration-info="current_driving_status == 'on_trip'"
                           decoration-warning="current_driving_status == 'on_leave'"
                           decoration-muted="current_driving_status == 'not_available'"/>
                    <field name="driver_license_state" string="License" optional="show" widget="badge"
                           decoration-success="driver_license_state == 'valid'"
                           decoration-warning="driver_license_state == 'expiring_soon'"
                           decoration-danger="driver_license_state in ['expired', 'suspended', 'revoked']"/>
                </xpath>
            </field>
        </record>

        <!-- Driver Availability Kanban Dashboard -->
        <record id="view_driver_availability_kanban" model="ir.ui.view">
            <field name="name">hr.employee.driver.kanban</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <kanban default_group_by="current_driving_status" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="is_driver"/>
                    <field name="current_driving_status"/>
                    <field name="driver_license_state"/>
                    <field name="driver_license_number"/>
                    <field name="driver_license_expiry_date"/>
                    <field name="total_trips"/>
                    <field name="average_trip_rating"/>
                    <field name="job_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <i class="fa fa-user"/> <field name="name"/>
                                            </strong>
                                            <div class="o_kanban_record_subtitle">
                                                <i class="fa fa-briefcase"/> <field name="job_id"/>
                                            </div>
                                        </div>
                                        <!-- Status Badges -->
                                        <div>
                                            <span t-attf-class="badge badge-pill badge-#{record.current_driving_status.raw_value}">
                                                <field name="current_driving_status"/>
                                            </span>
                                            <br/>
                                            <span t-attf-class="badge badge-pill badge-#{record.driver_license_state.raw_value} mt-1">
                                                <field name="driver_license_state"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div>
                                            <i class="fa fa-id-card"/> License: <field name="driver_license_number"/>
                                        </div>
                                        <div>
                                            <i class="fa fa-calendar"/> Expires: <field name="driver_license_expiry_date"/>
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge badge-info">
                                                <i class="fa fa-road"/> <field name="total_trips"/> trips
                                            </span>
                                            <span class="badge badge-success ml-1" t-if="record.average_trip_rating.raw_value">
                                                <i class="fa fa-star"/> <field name="average_trip_rating"/> rating
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Drivers List View (Enhanced) -->
        <record id="view_drivers_list" model="ir.ui.view">
            <field name="name">hr.employee.drivers.list</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <list string="Drivers"
                      decoration-success="current_driving_status == 'available' and driver_license_state == 'valid'"
                      decoration-warning="driver_license_state == 'expiring_soon' or current_driving_status == 'on_leave'"
                      decoration-danger="driver_license_state in ['expired', 'suspended', 'revoked']"
                      decoration-info="current_driving_status == 'on_trip'">
                    <!-- Key fields -->
                    <field name="name"/>
                    <field name="job_id" optional="show"/>
                    <field name="driver_license_number"/>

                    <!-- Status badges (always visible) -->
                    <field name="current_driving_status" string="Availability" widget="badge" optional="show"
                           decoration-success="current_driving_status == 'available'"
                           decoration-info="current_driving_status == 'on_trip'"
                           decoration-warning="current_driving_status == 'on_leave'"
                           decoration-muted="current_driving_status == 'not_available'"/>

                    <field name="driver_license_state" string="License Status" widget="badge" optional="show"
                           decoration-success="driver_license_state == 'valid'"
                           decoration-warning="driver_license_state == 'expiring_soon'"
                           decoration-danger="driver_license_state in ['expired', 'suspended', 'revoked']"/>

                    <!-- Additional info -->
                    <field name="driver_license_expiry_date" optional="show"/>
                    <field name="total_trips" optional="hide"/>
                    <field name="average_trip_rating" optional="hide"/>
                    <field name="is_driver" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Driver Availability Dashboard Action -->
        <record id="action_driver_availability_dashboard" model="ir.actions.act_window">
            <field name="name">Driver Availability Dashboard</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_driver_availability_kanban"/>
            <field name="domain">[('is_driver', '=', True)]</field>
            <field name="context">{'default_is_driver': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No drivers found!
                </p>
                <p>
                    Create drivers to track their availability and assignments.
                </p>
            </field>
        </record>

        <!-- Driver Employees Action -->
        <record id="action_driver_employees" model="ir.actions.act_window">
            <field name="name">All Drivers</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_drivers_list')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_driver_availability_kanban')}),
                (0, 0, {'view_mode': 'form'})]"/>
            <field name="domain">[('is_driver', '=', True)]</field>
            <field name="context">{'default_is_driver': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No drivers found. Create one!
                </p>
                <p>
                    Manage your fleet drivers here.
                </p>
            </field>
        </record>

        <!-- Available Drivers Action -->
        <record id="action_available_drivers" model="ir.actions.act_window">
            <field name="name">Available Drivers</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_driver_availability_kanban"/>
            <field name="domain">[('is_driver', '=', True), ('is_available_for_driving', '=', True)]</field>
            <field name="context">{'default_is_driver': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    All drivers are currently unavailable.
                </p>
                <p>
                    Available drivers will appear here.
                </p>
            </field>
        </record>

    </data>
</odoo>
