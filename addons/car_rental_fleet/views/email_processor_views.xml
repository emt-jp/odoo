<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Email Processor List View -->
    <record id="view_tdc_email_processor_list" model="ir.ui.view">
        <field name="name">tdc.email.processor.list</field>
        <field name="model">tdc.email.processor</field>
        <field name="arch" type="xml">
            <list string="AI Email Processor"
                  decoration-success="state == 'processed'"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'review'"
                  decoration-muted="state in ('ignored', 'unsubscribed')"
                  decoration-info="state == 'classified'">
                <field name="create_date" string="Received"/>
                <field name="email_from" string="From"/>
                <field name="email_to" string="Inbox"/>
                <field name="name" string="Subject"/>
                <field name="classification" widget="badge"/>
                <field name="confidence" widget="progressbar"/>
                <field name="ai_summary" string="Summary"/>
                <field name="state" widget="badge"/>
                <field name="booking_id" string="Booking" optional="show"/>
                <field name="invoice_id" string="Invoice" optional="show"/>
                <field name="task_id" string="Task" optional="show"/>
                <field name="lead_id" string="Lead" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Email Processor Form View -->
    <record id="view_tdc_email_processor_form" model="ir.ui.view">
        <field name="name">tdc.email.processor.form</field>
        <field name="model">tdc.email.processor</field>
        <field name="arch" type="xml">
            <form string="AI Email Processor">
                <header>
                    <button name="action_reprocess" type="object" string="Re-classify with AI"
                            class="btn-primary"
                            invisible="state not in ('error', 'review', 'received')"/>
                    <button name="action_force_process" type="object" string="Force Process"
                            class="btn-warning"
                            invisible="state != 'review'"/>
                    <button name="action_mark_ignored" type="object" string="Ignore"
                            invisible="state in ('processed', 'ignored', 'unsubscribed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,classified,processed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Email Subject"/></h1>
                    </div>
                    <group>
                        <group string="Email Info">
                            <field name="email_from"/>
                            <field name="email_to"/>
                            <field name="create_date" string="Received"/>
                        </group>
                        <group string="AI Classification">
                            <field name="classification"/>
                            <field name="confidence" widget="progressbar"/>
                            <field name="ai_summary"/>
                        </group>
                    </group>
                    <group>
                        <group string="Created Records">
                            <field name="booking_id" invisible="not booking_id"/>
                            <field name="invoice_id" invisible="not invoice_id"/>
                            <field name="task_id" invisible="not task_id"/>
                            <field name="project_id" invisible="not project_id"/>
                            <field name="lead_id" invisible="not lead_id"/>
                            <field name="partner_id" invisible="not partner_id"/>
                        </group>
                        <group string="Details">
                            <field name="unsubscribe_url" invisible="not unsubscribe_url" widget="url"/>
                            <field name="error_message" invisible="not error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extracted Data">
                            <field name="extracted_data" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Raw Email">
                            <field name="raw_email" readonly="1"/>
                        </page>
                        <page string="AI Response">
                            <field name="ai_raw_response" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Email Processor Search View -->
    <record id="view_tdc_email_processor_search" model="ir.ui.view">
        <field name="name">tdc.email.processor.search</field>
        <field name="model">tdc.email.processor</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Processed" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Needs Review" name="review" domain="[('state', '=', 'review')]"/>
                <filter string="Errors" name="errors" domain="[('state', '=', 'error')]"/>
                <filter string="Bookings" name="bookings" domain="[('classification', 'in', ['rental_booking', 'rental_cancel'])]"/>
                <filter string="Invoices" name="invoices" domain="[('classification', 'in', ['invoice', 'expense'])]"/>
                <filter string="Tasks" name="tasks" domain="[('classification', '=', 'task')]"/>
                <filter string="Inquiries" name="inquiries" domain="[('classification', '=', 'customer_inquiry')]"/>
                <filter string="Spam" name="spam" domain="[('classification', '=', 'spam')]"/>
                <filter string="Today" name="today" domain="[('create_date', '>=', (context_today()).strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <!-- Email Processor Action -->
    <record id="action_tdc_email_processor" model="ir.actions.act_window">
        <field name="name">AI Email Inbox</field>
        <field name="res_model">tdc.email.processor</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No emails processed yet
            </p>
            <p>
                Configure incoming mail servers to automatically receive
                emails. Claude AI will classify each email and route it
                to the appropriate Odoo module.
            </p>
        </field>
    </record>

    <!-- Top-level menu -->
    <menuitem
        id="menu_tdc_email_processor_root"
        name="AI Email Inbox"
        web_icon="car_rental_fleet,static/description/icon.png"
        sequence="5"/>

    <menuitem
        id="menu_tdc_email_processor"
        name="All Emails"
        parent="menu_tdc_email_processor_root"
        action="action_tdc_email_processor"
        sequence="10"/>

</odoo>
