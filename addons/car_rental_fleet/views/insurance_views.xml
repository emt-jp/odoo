<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Insurance Policy List View -->
    <record id="view_fleet_insurance_tree" model="ir.ui.view">
        <field name="name">fleet.insurance.tree</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <list string="Insurance Policies" decoration-danger="status == 'expired'" decoration-warning="status == 'pending'">
                <field name="policy_number"/>
                <field name="vehicle_id"/>
                <field name="insurance_company"/>
                <field name="insurance_type"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="status"/>
                <field name="coverage_amount"/>
                <field name="premium_amount"/>
            </list>
        </field>
    </record>

    <!-- Insurance Policy Form View -->
    <record id="view_fleet_insurance_form" model="ir.ui.view">
        <field name="name">fleet.insurance.form</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <form string="Insurance Policy">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="claims_count" widget="statinfo" string="Claims"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="policy_number"/>
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="insurance_company"/>
                            <field name="insurance_type"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="coverage_amount"/>
                            <field name="premium_amount"/>
                            <field name="deductible_amount"/>
                        </group>
                    </group>
                    <group string="Contact Information">
                        <group>
                            <field name="agent_name"/>
                            <field name="agent_phone"/>
                            <field name="agent_email"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <group>
                            <field name="policy_document" filename="policy_filename"/>
                            <field name="certificate_document" filename="certificate_filename"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Claims" name="claims">
                            <field name="claim_ids" nolabel="1">
                                <list>
                                    <field name="claim_number"/>
                                    <field name="claim_date"/>
                                    <field name="incident_date"/>
                                    <field name="claim_type"/>
                                    <field name="claim_amount"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Insurance Policy Search View -->
    <record id="view_fleet_insurance_search" model="ir.ui.view">
        <field name="name">fleet.insurance.search</field>
        <field name="model">fleet.insurance</field>
        <field name="arch" type="xml">
            <search string="Insurance Policies">
                <field name="policy_number"/>
                <field name="vehicle_id"/>
                <field name="insurance_company"/>
                <field name="insurance_type"/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                <filter string="Expiring Soon" name="expiring_soon" domain="[('status', '=', 'expiring_soon')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Insurance Type" name="group_type" context="{'group_by': 'insurance_type'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Insurance Company" name="group_company" context="{'group_by': 'insurance_company'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Insurance Policy Action -->
    <record id="action_fleet_insurance" model="ir.actions.act_window">
        <field name="name">Insurance Policies</field>
        <field name="res_model">fleet.insurance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first insurance policy!
            </p>
            <p>
                Manage insurance policies for your fleet vehicles.
            </p>
        </field>
    </record>

    <!-- Insurance Claim List View -->
    <record id="view_fleet_insurance_claim_tree" model="ir.ui.view">
        <field name="name">fleet.insurance.claim.tree</field>
        <field name="model">fleet.insurance.claim</field>
        <field name="arch" type="xml">
            <list string="Insurance Claims" decoration-info="status == 'submitted'" decoration-warning="status == 'under_review'" decoration-success="status == 'approved'">
                <field name="claim_number"/>
                <field name="insurance_id"/>
                <field name="vehicle_id"/>
                <field name="claim_date"/>
                <field name="incident_date"/>
                <field name="claim_type"/>
                <field name="claim_amount"/>
                <field name="approved_amount"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Insurance Claim Form View -->
    <record id="view_fleet_insurance_claim_form" model="ir.ui.view">
        <field name="name">fleet.insurance.claim.form</field>
        <field name="model">fleet.insurance.claim</field>
        <field name="arch" type="xml">
            <form string="Insurance Claim">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="submitted,under_review,approved,settled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="claim_number"/>
                            <field name="insurance_id" options="{'no_create': True}"/>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="claim_date"/>
                            <field name="incident_date"/>
                            <field name="incident_location"/>
                            <field name="claim_type"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="claim_amount"/>
                            <field name="approved_amount" readonly="status not in ['under_review', 'approved']"/>
                            <field name="settlement_amount" readonly="status not in ['approved', 'settled']"/>
                            <field name="settlement_date" readonly="status != 'settled'"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Describe the incident..."/>
                        <field name="damage_description" placeholder="Describe the damage..."/>
                    </group>
                    <group string="Documents">
                        <group>
                            <field name="police_report" filename="police_report_filename"/>
                            <field name="photos" filename="photos_filename"/>
                            <field name="estimate_document" filename="estimate_filename"/>
                        </group>
                    </group>
                    <group string="Settlement" invisible="status != 'settled'">
                        <field name="settlement_notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Insurance Claim Search View -->
    <record id="view_fleet_insurance_claim_search" model="ir.ui.view">
        <field name="name">fleet.insurance.claim.search</field>
        <field name="model">fleet.insurance.claim</field>
        <field name="arch" type="xml">
            <search string="Insurance Claims">
                <field name="claim_number"/>
                <field name="insurance_id"/>
                <field name="vehicle_id"/>
                <field name="claim_type"/>
                <filter string="Submitted" name="submitted" domain="[('status', '=', 'submitted')]"/>
                <filter string="Under Review" name="under_review" domain="[('status', '=', 'under_review')]"/>
                <filter string="Approved" name="approved" domain="[('status', '=', 'approved')]"/>
                <filter string="Settled" name="settled" domain="[('status', '=', 'settled')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Claim Type" name="group_type" context="{'group_by': 'claim_type'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Insurance Policy" name="group_insurance" context="{'group_by': 'insurance_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Insurance Claim Action -->
    <record id="action_fleet_insurance_claim" model="ir.actions.act_window">
        <field name="name">Insurance Claims</field>
        <field name="res_model">fleet.insurance.claim</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first insurance claim!
            </p>
            <p>
                Track and manage insurance claims for your fleet.
            </p>
        </field>
    </record>

    <!-- Fleet Document List View -->
    <record id="view_fleet_document_tree" model="ir.ui.view">
        <field name="name">fleet.document.tree</field>
        <field name="model">fleet.document</field>
        <field name="arch" type="xml">
            <list string="Documents" decoration-danger="status == 'expired'" decoration-warning="status == 'expiring_soon'">
                <field name="document_name"/>
                <field name="document_type"/>
                <field name="vehicle_id"/>
                <field name="document_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Fleet Document Form View -->
    <record id="view_fleet_document_form" model="ir.ui.view">
        <field name="name">fleet.document.form</field>
        <field name="model">fleet.document</field>
        <field name="arch" type="xml">
            <form string="Fleet Document">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="valid,expiring_soon,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="document_name"/>
                            <field name="document_type"/>
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="document_number"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Document">
                        <field name="document_file" filename="document_filename"/>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Add description..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Fleet Document Search View -->
    <record id="view_fleet_document_search" model="ir.ui.view">
        <field name="name">fleet.document.search</field>
        <field name="model">fleet.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="document_name"/>
                <field name="document_number"/>
                <field name="vehicle_id"/>
                <field name="document_type"/>
                <filter string="Valid" name="valid" domain="[('status', '=', 'valid')]"/>
                <filter string="Expiring Soon" name="expiring_soon" domain="[('status', '=', 'expiring_soon')]"/>
                <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Document Type" name="group_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Fleet Document Action -->
    <record id="action_fleet_document" model="ir.actions.act_window">
        <field name="name">Fleet Documents</field>
        <field name="res_model">fleet.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_valid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first document!
            </p>
            <p>
                Manage documents for your fleet vehicles.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_fleet_insurance_root" name="Insurance" parent="menu_car_rental_operations" sequence="30"/>
    <menuitem id="menu_fleet_insurance" name="Insurance Policies" parent="menu_fleet_insurance_root" action="action_fleet_insurance" sequence="10"/>
    <menuitem id="menu_fleet_insurance_claim" name="Claims" parent="menu_fleet_insurance_root" action="action_fleet_insurance_claim" sequence="20"/>
    <menuitem id="menu_fleet_document" name="Documents" parent="menu_fleet_insurance_root" action="action_fleet_document" sequence="30"/>

</odoo>