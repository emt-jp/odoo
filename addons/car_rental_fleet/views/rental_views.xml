<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rental Kanban View -->
    <record id="view_fleet_rental_kanban" model="ir.ui.view">
        <field name="name">fleet.rental.kanban</field>
        <field name="model">fleet.rental</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <field name="payment_status"/>
                <field name="rental_duration"/>
                <field name="total_amount"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <i class="fa fa-calendar-check-o"/> <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <i class="fa fa-user"/> <field name="customer_id"/>
                                        </div>
                                    </div>
                                    <!-- Status Badges -->
                                    <div>
                                        <span t-attf-class="badge badge-pill badge-#{record.state.raw_value}">
                                            <field name="state"/>
                                        </span>
                                        <br/>
                                        <span t-attf-class="badge badge-pill badge-#{record.payment_status.raw_value} mt-1">
                                            <field name="payment_status"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-car"/> <field name="vehicle_id"/>
                                    </div>
                                    <div class="mt-2">
                                        <i class="fa fa-calendar"/> Start: <field name="start_date"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-calendar-check-o"/> End: <field name="end_date"/>
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge badge-info">
                                            <i class="fa fa-clock-o"/> <field name="rental_duration"/> days
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <strong class="text-primary">
                                            <i class="fa fa-money"/> <field name="total_amount" widget="monetary"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Rental List View -->
    <record id="view_fleet_rental_list" model="ir.ui.view">
        <field name="name">fleet.rental.list</field>
        <field name="model">fleet.rental</field>
        <field name="arch" type="xml">
            <list string="Rentals"
                  decoration-muted="state == 'draft'"
                  decoration-info="state == 'confirmed'"
                  decoration-success="state == 'in_progress'"
                  decoration-warning="state == 'completed'"
                  decoration-danger="state in ('cancelled', 'overdue')">
                <!-- Always visible key fields -->
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rental_duration" optional="show"/>

                <!-- Status badges (always visible) -->
                <field name="state" string="Status" widget="badge" optional="show"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'in_progress'"
                       decoration-warning="state == 'completed'"
                       decoration-danger="state in ('cancelled', 'overdue')"/>

                <field name="payment_status" string="Payment" widget="badge" optional="show"
                       decoration-danger="payment_status == 'overdue'"
                       decoration-warning="payment_status == 'pending'"
                       decoration-info="payment_status == 'partial'"
                       decoration-success="payment_status == 'paid'"/>

                <!-- Financial fields -->
                <field name="total_amount" widget="monetary" optional="show"/>
                <field name="base_amount" widget="monetary" optional="hide"/>
                <field name="discount_amount" widget="monetary" optional="hide"/>

                <!-- Optional secondary fields -->
                <field name="driver_id" optional="hide"/>
                <field name="customer_rating" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Rental Calendar View -->
    <record id="view_fleet_rental_calendar" model="ir.ui.view">
        <field name="name">fleet.rental.calendar</field>
        <field name="model">fleet.rental</field>
        <field name="arch" type="xml">
            <calendar string="Rentals" date_start="start_date" date_stop="end_date" color="state" mode="month" quick_create="0">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Rental Form View -->
    <record id="view_fleet_rental_form" model="ir.ui.view">
        <field name="name">fleet.rental.form</field>
        <field name="model">fleet.rental</field>
        <field name="arch" type="xml">
            <form string="Rental">
                <header>
                    <button name="action_confirm" string="Confirm Rental" type="object"
                            class="oe_highlight" icon="fa-check" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Rental" type="object"
                            class="oe_highlight" icon="fa-play" invisible="state != 'confirmed'"/>
                    <button name="action_complete" string="Complete Rental" type="object"
                            class="oe_highlight" icon="fa-check-circle" invisible="state != 'in_progress'"/>
                    <button name="action_cancel_rental" string="Cancel" type="object"
                            icon="fa-times" invisible="state in ('cancelled', 'completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rental Reference"/></h1>
                    </div>

                    <!-- Payment Status Alert -->
                    <div class="alert alert-danger" role="alert" invisible="payment_status != 'overdue'">
                        <h4 class="alert-heading">
                            <i class="fa fa-exclamation-triangle"/> PAYMENT OVERDUE
                        </h4>
                        <p class="mb-0">This rental payment is overdue. Please collect payment immediately.</p>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="payment_status != 'pending'">
                        <h4 class="alert-heading">
                            <i class="fa fa-clock-o"/> PAYMENT PENDING
                        </h4>
                        <p class="mb-0">Payment for this rental is still pending.</p>
                    </div>

                    <!-- Rental Information -->
                    <group string="🚗 Rental Information">
                        <group>
                            <field name="vehicle_id" options="{'no_create': False}"/>
                            <field name="customer_id" options="{'no_create': False}"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="rental_duration" readonly="1"/>
                        </group>
                    </group>

                    <!-- Locations & Driver -->
                    <group string="📍 Pickup &amp; Return Details">
                        <group>
                            <field name="pickup_location"/>
                            <field name="return_location"/>
                            <field name="pickup_instructions" placeholder="Pickup instructions..."/>
                            <field name="return_instructions" placeholder="Return instructions..."/>
                        </group>
                        <group>
                            <field name="driver_id" options="{'no_create': False}"/>
                            <field name="driver_license_number"/>
                            <field name="driver_license_expiry"/>
                        </group>
                    </group>

                    <!-- ENHANCED PRICING SECTION with Visual Breakdown -->
                    <group string="💰 Pricing Breakdown">
                        <!-- Pricing Rates -->
                        <group string="Rental Rates">
                            <field name="daily_rate" widget="monetary"/>
                            <field name="weekly_rate" widget="monetary"/>
                            <field name="monthly_rate" widget="monetary"/>
                        </group>
                        <group string="Rate Applied">
                            <field name="base_amount" readonly="1" widget="monetary"
                                   decoration-info="base_amount &gt; 0"/>
                        </group>
                    </group>

                    <!-- Visual Pricing Summary Card -->
                    <group>
                        <div class="alert alert-info" role="alert">
                            <h4><i class="fa fa-calculator"/> Pricing Summary</h4>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <td><strong>Base Amount:</strong></td>
                                        <td class="text-right">
                                            <field name="base_amount" readonly="1" widget="monetary" nolabel="1"/>
                                        </td>
                                    </tr>
                                    <tr invisible="not discount_amount or discount_amount == 0">
                                        <td>
                                            <strong>Discount:</strong>
                                            (<field name="discount_type" readonly="1" nolabel="1"/>
                                            <field name="discount_value" readonly="1" nolabel="1"/>)
                                        </td>
                                        <td class="text-right text-success">
                                            - <field name="discount_amount" readonly="1" widget="monetary" nolabel="1"/>
                                        </td>
                                    </tr>
                                    <tr invisible="not total_charges or total_charges == 0">
                                        <td><strong>Additional Charges:</strong></td>
                                        <td class="text-right text-warning">
                                            + <field name="total_charges" readonly="1" widget="monetary" nolabel="1"/>
                                        </td>
                                    </tr>
                                    <tr class="table-active">
                                        <td><h4><strong>Total Amount:</strong></h4></td>
                                        <td class="text-right">
                                            <h4 class="text-primary">
                                                <strong><field name="total_amount" readonly="1" widget="monetary" nolabel="1"/></strong>
                                            </h4>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <field name="currency_id" invisible="1"/>
                        </div>
                    </group>

                    <!-- Discount Configuration -->
                    <group string="🎟️ Discount Configuration" invisible="state in ('completed', 'cancelled')">
                        <group>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                        </group>
                        <group>
                            <field name="discount_amount" readonly="1" widget="monetary"
                                   decoration-success="discount_amount &gt; 0"/>
                        </group>
                    </group>

                    <!-- Payment Status -->
                    <group string="💳 Payment Status">
                        <group>
                            <field name="payment_status" widget="badge"
                                   decoration-danger="payment_status == 'overdue'"
                                   decoration-warning="payment_status == 'pending'"
                                   decoration-info="payment_status == 'partial'"
                                   decoration-success="payment_status == 'paid'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Additional Charges" name="charges">
                            <field name="additional_charges" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="charge_type"/>
                                    <field name="amount"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vehicle Condition">
                            <group>
                                <field name="pickup_condition" placeholder="Vehicle condition at pickup..."/>
                                <field name="return_condition" placeholder="Vehicle condition at return..."/>
                                <field name="damage_report" placeholder="Damage report..."/>
                                <field name="damage_photos" filename="damage_photos_filename"/>
                            </group>
                        </page>
                        <page string="Insurance">
                            <group>
                                <field name="insurance_required"/>
                                <field name="insurance_provider"/>
                                <field name="insurance_policy_number"/>
                            </group>
                        </page>
                        <page string="Feedback">
                            <group>
                                <field name="customer_rating"/>
                                <field name="customer_feedback" placeholder="Customer feedback..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Rental Search View -->
    <record id="view_fleet_rental_search" model="ir.ui.view">
        <field name="name">fleet.rental.search</field>
        <field name="model">fleet.rental</field>
        <field name="arch" type="xml">
            <search string="Rentals">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Overdue" name="overdue" domain="[('state', '=', 'overdue')]"/>
                <separator/>
                <filter string="Pending Payment" name="pending_payment" domain="[('payment_status', '=', 'pending')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Payment Status" name="group_payment" context="{'group_by': 'payment_status'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Rental Action -->
    <record id="action_fleet_rental" model="ir.actions.act_window">
        <field name="name">Rentals</field>
        <field name="res_model">fleet.rental</field>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first rental!
            </p>
            <p>
                Manage active rentals and track vehicle usage.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_fleet_rental" name="Rentals" parent="menu_car_rental_operations" action="action_fleet_rental" sequence="20"/>

</odoo>

