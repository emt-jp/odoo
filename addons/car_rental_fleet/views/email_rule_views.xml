<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tdc_email_rule_list" model="ir.ui.view">
        <field name="name">tdc.email.rule.list</field>
        <field name="model">tdc.email.rule</field>
        <field name="arch" type="xml">
            <list string="Email Classification Rules"
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="sender_pattern"/>
                <field name="subject_pattern" optional="show"/>
                <field name="body_pattern" optional="hide"/>
                <field name="match_type"/>
                <field name="classification" widget="badge"/>
                <field name="confidence" widget="progressbar"/>
                <field name="hit_count"/>
                <field name="last_matched"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_tdc_email_rule_form" model="ir.ui.view">
        <field name="name">tdc.email.rule.form</field>
        <field name="model">tdc.email.rule</field>
        <field name="arch" type="xml">
            <form string="Email Classification Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rule name (e.g. Rakuten booking confirmations)"/></h1>
                    </div>
                    <group>
                        <group string="Match Criteria">
                            <field name="match_type"/>
                            <field name="sender_pattern"
                                   placeholder="e.g. rakuten.co.jp"/>
                            <field name="subject_pattern"
                                   placeholder="e.g. 予約確認"/>
                            <field name="body_pattern" placeholder="optional"/>
                        </group>
                        <group string="Action">
                            <field name="classification"/>
                            <field name="confidence"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Stats">
                        <group>
                            <field name="hit_count"/>
                            <field name="last_matched"/>
                        </group>
                        <group>
                            <field name="created_from_email_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tdc_email_rule_search" model="ir.ui.view">
        <field name="name">tdc.email.rule.search</field>
        <field name="model">tdc.email.rule</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <filter string="By Classification" name="by_classification"
                        context="{'group_by': 'classification'}"/>
            </search>
        </field>
    </record>

    <record id="action_tdc_email_rule" model="ir.actions.act_window">
        <field name="name">Classification Rules</field>
        <field name="res_model">tdc.email.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No rules yet
            </p>
            <p>
                Rules let you teach the email processor to classify known
                senders without calling Claude — cheaper and instant. Click
                <b>Create Rule</b> on any email you manually corrected to
                generate one automatically.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_tdc_email_rule"
        name="Classification Rules"
        parent="menu_tdc_email_processor_root"
        action="action_tdc_email_rule"
        sequence="20"/>

</odoo>
