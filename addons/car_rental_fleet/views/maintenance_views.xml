<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance Kanban View -->
    <record id="view_fleet_maintenance_kanban" model="ir.ui.view">
        <field name="name">fleet.maintenance.kanban</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="maintenance_type"/>
                <field name="service_start_date"/>
                <field name="service_end_date"/>
                <field name="periodic_type"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="total_cost"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click" t-attf-class="oe_kanban_color_#{kanban_getcolor(priority)}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="vehicle_id"/>
                                    <field name="maintenance_type"/>
                                    <t t-if="record.periodic_type.value">
                                        <span class="badge text-bg-info"><field name="periodic_type"/></span>
                                    </t>
                                    <div>
                                        <i class="fa fa-calendar"/> <field name="service_start_date"/> - <field name="service_end_date"/>
                                    </div>
                                    <div>
                                        <strong><field name="total_cost"/></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Maintenance List View -->
    <record id="view_fleet_maintenance_list" model="ir.ui.view">
        <field name="name">fleet.maintenance.list</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance"
                  decoration-danger="priority == 'urgent'"
                  decoration-warning="priority == 'high'"
                  decoration-success="status == 'completed'"
                  decoration-info="status == 'in_progress'"
                  decoration-muted="status == 'cancelled'">
                <!-- Always visible key fields -->
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="maintenance_type"/>

                <!-- Dates -->
                <field name="service_start_date"/>
                <field name="service_end_date" optional="show"/>
                <field name="scheduled_date" optional="hide"/>

                <!-- Status badges (always visible) -->
                <field name="status" string="Status" widget="badge" optional="show"
                       decoration-muted="status == 'scheduled'"
                       decoration-info="status == 'in_progress'"
                       decoration-success="status == 'completed'"
                       decoration-danger="status == 'cancelled'"/>

                <field name="priority" string="Priority" widget="badge" optional="show"
                       decoration-danger="priority == 'urgent'"
                       decoration-warning="priority == 'high'"
                       decoration-info="priority == 'normal'"
                       decoration-muted="priority == 'low'"/>

                <!-- Type indicators -->
                <field name="periodic_type" string="Periodic" widget="badge" optional="show"/>
                <field name="km_threshold" optional="hide" string="KM Threshold"/>

                <!-- Cost -->
                <field name="total_cost" widget="monetary" optional="show"
                       decoration-warning="total_cost &gt; 1000"
                       decoration-danger="total_cost &gt; 5000"/>

                <!-- Duration tracking -->
                <field name="estimated_duration" optional="hide"/>
                <field name="actual_duration" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Maintenance Calendar View -->
    <record id="view_fleet_maintenance_calendar" model="ir.ui.view">
        <field name="name">fleet.maintenance.calendar</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <calendar string="Maintenance" date_start="service_start_date" date_stop="service_end_date" color="priority" mode="month" quick_create="0">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="maintenance_type"/>
                <field name="periodic_type"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <!-- Maintenance Form View -->
    <record id="view_fleet_maintenance_form" model="ir.ui.view">
        <field name="name">fleet.maintenance.form</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance">
                <header>
                    <button name="action_start" string="Start Maintenance" type="object"
                            class="oe_highlight" icon="fa-play" invisible="status != 'scheduled'"/>
                    <button name="action_complete" string="Complete" type="object"
                            class="oe_highlight" icon="fa-check-circle" invisible="status != 'in_progress'"/>
                    <button name="action_generate_periodic_services" string="Generate Periodic Services"
                            type="object" icon="fa-refresh" invisible="not is_periodic or not periodic_type"/>
                    <button name="action_cancel_maintenance" string="Cancel" type="object"
                            icon="fa-times" invisible="status == 'completed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="scheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <!-- Priority/Urgency Alert -->
                    <div class="alert alert-danger" role="alert" invisible="priority != 'urgent'">
                        <h4 class="alert-heading">
                            <i class="fa fa-exclamation-triangle"/> URGENT MAINTENANCE
                        </h4>
                        <p class="mb-0">This maintenance task is marked as URGENT. Please prioritize immediately.</p>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="priority != 'high' or status != 'scheduled'">
                        <h4 class="alert-heading">
                            <i class="fa fa-exclamation-circle"/> HIGH PRIORITY
                        </h4>
                        <p class="mb-0">This is a high priority maintenance task. Schedule soon.</p>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" placeholder="Maintenance Task"/></h1>
                    </div>

                    <!-- Basic Information -->
                    <group string="🔧 Maintenance Information">
                        <group>
                            <field name="vehicle_id" options="{'no_create': False}"/>
                            <field name="maintenance_type"/>
                            <field name="priority" widget="badge"
                                   decoration-danger="priority == 'urgent'"
                                   decoration-warning="priority == 'high'"
                                   decoration-info="priority == 'normal'"
                                   decoration-muted="priority == 'low'"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="estimated_duration" string="Est. Duration (hours)"/>
                        </group>
                    </group>

                    <!-- Progress Tracking (visible when in progress or completed) -->
                    <group string="📊 Progress Tracking" invisible="status == 'scheduled'">
                        <div class="alert alert-info" role="alert" invisible="status != 'in_progress'">
                            <h4><i class="fa fa-clock-o"/> Maintenance In Progress</h4>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <td><strong>Started:</strong></td>
                                        <td><field name="actual_start_date" readonly="1" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Estimated Duration:</strong></td>
                                        <td><field name="estimated_duration" readonly="1" nolabel="1"/> hours</td>
                                    </tr>
                                    <tr invisible="not actual_duration or actual_duration == 0">
                                        <td><strong>Actual Duration:</strong></td>
                                        <td><field name="actual_duration" readonly="1" nolabel="1"/> hours</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="alert alert-success" role="alert" invisible="status != 'completed'">
                            <h4><i class="fa fa-check-circle"/> Maintenance Completed</h4>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <td><strong>Started:</strong></td>
                                        <td><field name="actual_start_date" readonly="1" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Completed:</strong></td>
                                        <td><field name="actual_end_date" readonly="1" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Actual Duration:</strong></td>
                                        <td>
                                            <field name="actual_duration" readonly="1" nolabel="1"/> hours
                                            (vs. <field name="estimated_duration" readonly="1" nolabel="1"/> estimated)
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <group>
                            <field name="actual_start_date" readonly="status != 'in_progress'"/>
                            <field name="actual_end_date" readonly="status != 'completed'"/>
                        </group>
                    </group>
                    <group string="Service Period (Vehicle Unavailable)" col="4">
                        <field name="service_start_date"/>
                        <field name="service_end_date"/>
                    </group>
                    <group string="Periodic Service Settings">
                        <group>
                            <field name="is_periodic"/>
                            <field name="periodic_type" invisible="not is_periodic"/>
                        </group>
                        <group>
                            <field name="parent_service_id" readonly="1" invisible="not parent_service_id"/>
                            <field name="child_service_ids" invisible="not child_service_ids" readonly="1" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="KM-Based Service" invisible="not is_km_based">
                        <field name="is_km_based" readonly="1"/>
                        <field name="km_threshold" readonly="1"/>
                    </group>
                    <group string="Service Provider">
                        <group>
                            <field name="service_provider_id" options="{'no_create': False}"/>
                            <field name="service_provider_type"/>
                        </group>
                        <group>
                            <field name="technician_id" options="{'no_create': False}"/>
                            <field name="technician_notes" placeholder="Technician notes..."/>
                        </group>
                    </group>
                    <group string="📝 Description">
                        <field name="description" placeholder="Maintenance description..." nolabel="1"/>
                    </group>

                    <!-- ENHANCED COST BREAKDOWN with Visual Summary -->
                    <group string="💰 Cost Breakdown">
                        <group string="Labor Costs">
                            <field name="labor_hours"/>
                            <field name="labor_rate" widget="monetary"/>
                            <field name="total_labor_cost" readonly="1" widget="monetary"
                                   decoration-info="total_labor_cost &gt; 0"/>
                        </group>
                        <group string="Parts Costs">
                            <field name="total_parts_cost" readonly="1" widget="monetary"
                                   decoration-info="total_parts_cost &gt; 0"/>
                        </group>
                    </group>

                    <!-- Visual Cost Summary Card -->
                    <group>
                        <div class="alert alert-info" role="alert">
                            <h4><i class="fa fa-calculator"/> Cost Summary</h4>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <td><strong>Labor Cost:</strong></td>
                                        <td class="text-right">
                                            <field name="total_labor_cost" readonly="1" widget="monetary" nolabel="1"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Parts Cost:</strong></td>
                                        <td class="text-right">
                                            <field name="total_parts_cost" readonly="1" widget="monetary" nolabel="1"/>
                                        </td>
                                    </tr>
                                    <tr class="table-active">
                                        <td><h4><strong>Total Cost:</strong></h4></td>
                                        <td class="text-right">
                                            <h4 class="text-primary">
                                                <strong><field name="total_cost" readonly="1" widget="monetary" nolabel="1"/></strong>
                                            </h4>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div invisible="total_cost &lt;= 1000" class="mt-2">
                                <span class="badge badge-warning" invisible="total_cost &lt;= 5000">
                                    <i class="fa fa-exclamation-triangle"/> High Cost Alert
                                </span>
                                <span class="badge badge-danger" invisible="total_cost &lt;= 5000">
                                    <i class="fa fa-times-circle"/> Very High Cost Alert
                                </span>
                            </div>
                            <field name="currency_id" invisible="1"/>
                        </div>
                    </group>
                    <group string="Mileage">
                        <field name="odometer_reading"/>
                        <field name="next_service_odometer"/>
                    </group>
                    <notebook>
                        <page string="Parts Used" name="parts">
                            <field name="parts_used" nolabel="1">
                                <list>
                                    <field name="part_name"/>
                                    <field name="part_number"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents">
                            <group>
                                <field name="work_order" filename="work_order_filename"/>
                                <field name="inspection_report" filename="inspection_report_filename"/>
                                <field name="photos" filename="photos_filename"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Maintenance Search View -->
    <record id="view_fleet_maintenance_search" model="ir.ui.view">
        <field name="name">fleet.maintenance.search</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <search string="Maintenance">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="maintenance_type"/>
                <filter string="Scheduled" name="scheduled" domain="[('status', '=', 'scheduled')]"/>
                <filter string="In Progress" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter string="High Priority" name="high" domain="[('priority', '=', 'high')]"/>
                <separator/>
                <filter string="Periodic Services" name="periodic" domain="[('is_periodic', '=', True)]"/>
                <filter string="Monthly Check" name="monthly" domain="[('periodic_type', '=', 'monthly')]"/>
                <filter string="Quarterly Check" name="quarterly" domain="[('periodic_type', '=', 'quarterly')]"/>
                <filter string="Semi-Annual Check" name="semi_annual" domain="[('periodic_type', '=', 'semi_annual')]"/>
                <filter string="Annual Check" name="annual" domain="[('periodic_type', '=', 'annual')]"/>
                <separator/>
                <filter string="KM-Based Services" name="km_based" domain="[('is_km_based', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'maintenance_type'}"/>
                    <filter string="Periodic Type" name="group_periodic" context="{'group_by': 'periodic_type'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Maintenance Action -->
    <record id="action_fleet_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">fleet.maintenance</field>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="context">{'search_default_scheduled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first maintenance!
            </p>
            <p>
                Track and manage vehicle maintenance and repairs.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_fleet_maintenance" name="Maintenance" parent="menu_car_rental_operations" action="action_fleet_maintenance" sequence="40"/>

</odoo>

