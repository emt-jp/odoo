<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Damage Inspection Form View -->
    <record id="view_fleet_damage_inspection_form" model="ir.ui.view">
        <field name="name">fleet.damage.inspection.form</field>
        <field name="model">fleet.damage.inspection</field>
        <field name="arch" type="xml">
            <form string="Damage Inspection">
                <header>
                    <button name="action_start_inspection" string="Start Inspection" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete_inspection" string="Complete" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_approve_inspection" string="Approve" type="object" class="oe_highlight" invisible="state != 'completed'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ['in_progress', 'completed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="rental_id"/>
                            <field name="inspection_type"/>
                            <field name="inspection_date"/>
                        </group>
                        <group>
                            <field name="inspector_id"/>
                            <field name="customer_id"/>
                            <field name="odometer_reading"/>
                            <field name="fuel_level"/>
                            <field name="overall_condition"/>
                        </group>
                    </group>
                    <group string="Damage Summary" invisible="not has_damage">
                        <field name="has_damage"/>
                        <field name="total_damage_cost"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Checklist" name="checklist">
                            <field name="inspection_line_ids" nolabel="1"/>
                        </page>
                        <page string="Damages" name="damages">
                            <field name="damage_ids" nolabel="1"/>
                        </page>
                        <page string="Photos" name="photos">
                            <group>
                                <group>
                                    <field name="photo_front" widget="image"/>
                                    <field name="photo_back" widget="image"/>
                                    <field name="photo_left" widget="image"/>
                                </group>
                                <group>
                                    <field name="photo_right" widget="image"/>
                                    <field name="photo_interior" widget="image"/>
                                    <field name="photo_dashboard" widget="image"/>
                                </group>
                            </group>
                        </page>
                        <page string="Signatures" name="signatures">
                            <group>
                                <group>
                                    <field name="inspector_signature" widget="image"/>
                                </group>
                                <group>
                                    <field name="customer_signature" widget="image"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="notes" placeholder="Internal notes..."/>
                                <field name="customer_comments" placeholder="Customer comments..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Damage Inspection List View -->
    <record id="view_fleet_damage_inspection_list" model="ir.ui.view">
        <field name="name">fleet.damage.inspection.list</field>
        <field name="model">fleet.damage.inspection</field>
        <field name="arch" type="xml">
            <list string="Damage Inspections" decoration-danger="has_damage" decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="inspection_type"/>
                <field name="inspection_date"/>
                <field name="inspector_id"/>
                <field name="overall_condition"/>
                <field name="has_damage"/>
                <field name="total_damage_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Damage Inspection Search View -->
    <record id="view_fleet_damage_inspection_search" model="ir.ui.view">
        <field name="name">fleet.damage.inspection.search</field>
        <field name="model">fleet.damage.inspection</field>
        <field name="arch" type="xml">
            <search string="Damage Inspections">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="rental_id"/>
                <filter string="Pickup Inspections" name="pickup" domain="[('inspection_type', '=', 'pickup')]"/>
                <filter string="Return Inspections" name="return" domain="[('inspection_type', '=', 'return')]"/>
                <filter string="With Damage" name="has_damage" domain="[('has_damage', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'inspection_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Damage Inspection Action -->
    <record id="action_fleet_damage_inspection" model="ir.actions.act_window">
        <field name="name">Damage Inspections</field>
        <field name="res_model">fleet.damage.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first damage inspection!
            </p>
        </field>
    </record>

    <!-- Damage Record Form View -->
    <record id="view_fleet_damage_record_form" model="ir.ui.view">
        <field name="name">fleet.damage.record.form</field>
        <field name="model">fleet.damage.record</field>
        <field name="arch" type="xml">
            <form string="Damage Record">
                <sheet>
                    <group>
                        <group>
                            <field name="inspection_id"/>
                            <field name="vehicle_id"/>
                            <field name="damage_type"/>
                            <field name="location"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="estimated_cost"/>
                            <field name="actual_cost"/>
                            <field name="is_preexisting"/>
                            <field name="is_repaired"/>
                            <field name="repair_date" invisible="not is_repaired"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="repair_notes" invisible="not is_repaired"/>
                    </group>
                    <group string="Photos">
                        <field name="photo_1" widget="image"/>
                        <field name="photo_2" widget="image"/>
                        <field name="photo_3" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_fleet_damage_inspection" name="Damage Inspections" parent="menu_car_rental_operations" action="action_fleet_damage_inspection" sequence="45"/>

</odoo>
