<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron job to automatically generate KM-based service checks -->
    <record id="ir_cron_km_based_service" model="ir.cron">
        <field name="name">Fleet: Generate KM-Based Service Checks</field>
        <field name="model_id" ref="model_fleet_maintenance"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_km_based_services()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Cron job to check document expiry and create renewal reminders -->
    <record id="ir_cron_document_expiry_check" model="ir.cron">
        <field name="name">Fleet: Check Document Expiry &amp; Create Reminders</field>
        <field name="model_id" ref="model_fleet_vehicle_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_document_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
