<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jobhunt_interview_list" model="ir.ui.view">
        <field name="name">jobhunt.interview.list</field>
        <field name="model">jobhunt.interview</field>
        <field name="arch" type="xml">
            <list string="Interviews"
                  decoration-success="result=='passed'"
                  decoration-danger="result=='failed'">
                <field name="scheduled_at"/>
                <field name="application_id"/>
                <field name="company_id"/>
                <field name="round_no"/>
                <field name="interview_type"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="view_jobhunt_interview_form" model="ir.ui.view">
        <field name="name">jobhunt.interview.form</field>
        <field name="model">jobhunt.interview</field>
        <field name="arch" type="xml">
            <form string="Interview">
                <header>
                    <button name="action_generate_prep" type="object"
                            string="Generate Prep" class="btn-primary"/>
                    <field name="result" widget="statusbar"
                           statusbar_visible="pending,passed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="application_id"/>
                            <field name="company_id" readonly="1"/>
                            <field name="round_no"/>
                            <field name="interview_type"/>
                        </group>
                        <group>
                            <field name="scheduled_at"/>
                            <field name="interviewer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prep Notes">
                            <field name="prep_notes"/>
                        </page>
                        <page string="Anticipated Questions">
                            <field name="questions"/>
                        </page>
                        <page string="Feedback">
                            <field name="feedback"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_jobhunt_interview_search" model="ir.ui.view">
        <field name="name">jobhunt.interview.search</field>
        <field name="model">jobhunt.interview</field>
        <field name="arch" type="xml">
            <search>
                <field name="application_id"/>
                <field name="company_id"/>
                <filter name="upcoming" string="Upcoming"
                        domain="[('scheduled_at','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="pending" string="Pending result"
                        domain="[('result','=','pending')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type"
                            context="{'group_by':'interview_type'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_jobhunt_interview" model="ir.actions.act_window">
        <field name="name">Interviews</field>
        <field name="res_model">jobhunt.interview</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
