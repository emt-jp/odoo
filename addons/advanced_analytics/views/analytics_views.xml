<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Analytics Dashboard Views -->
    <record id="view_analytics_dashboard_tree" model="ir.ui.view">
        <field name="name">analytics.dashboard.tree</field>
        <field name="model">analytics.dashboard</field>
        <field name="arch" type="xml">
            <list string="Dashboards">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="dashboard_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_dashboard_form" model="ir.ui.view">
        <field name="name">analytics.dashboard.form</field>
        <field name="model">analytics.dashboard</field>
        <field name="arch" type="xml">
            <form string="Analytics Dashboard">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_dashboard" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <span>View Dashboard</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Dashboard Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="dashboard_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Dashboard description..."/>
                        </page>
                        <page string="KPIs" name="kpis">
                            <field name="kpi_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="kpi_type"/>
                                    <field name="target_value"/>
                                    <field name="color"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Access Control" name="access">
                            <group>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="group_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Chart Configuration" name="chart_config">
                            <field name="chart_config" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_analytics_dashboard_kanban" model="ir.ui.view">
        <field name="name">analytics.dashboard.kanban</field>
        <field name="model">analytics.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="dashboard_type"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_card_header">
                            <div class="o_kanban_card_header_title">
                                <strong><field name="name"/></strong>
                            </div>
                        </div>
                        <div class="o_kanban_card_content">
                            <field name="dashboard_type"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Analytics KPI Views -->
    <record id="view_analytics_kpi_tree" model="ir.ui.view">
        <field name="name">analytics.kpi.tree</field>
        <field name="model">analytics.kpi</field>
        <field name="arch" type="xml">
            <list string="KPIs">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kpi_type"/>
                <field name="target_value"/>
                <field name="color"/>
                <field name="dashboard_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_kpi_form" model="ir.ui.view">
        <field name="name">analytics.kpi.form</field>
        <field name="model">analytics.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kpi_type"/>
                            <field name="dashboard_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="target_value"/>
                            <field name="threshold_warning"/>
                            <field name="threshold_critical"/>
                            <field name="color"/>
                            <field name="icon"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Calculation" name="calculation">
                            <group>
                                <field name="model_name"/>
                                <field name="domain"/>
                                <field name="aggregation_function"/>
                                <field name="field_name"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Analytics Report Views -->
    <record id="view_analytics_report_tree" model="ir.ui.view">
        <field name="name">analytics.report.tree</field>
        <field name="model">analytics.report</field>
        <field name="arch" type="xml">
            <list string="Analytics Reports">
                <field name="name"/>
                <field name="report_type"/>
                <field name="schedule_type"/>
                <field name="last_run"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_report_form" model="ir.ui.view">
        <field name="name">analytics.report.form</field>
        <field name="model">analytics.report</field>
        <field name="arch" type="xml">
            <form string="Analytics Report">
                <header>
                    <button name="action_generate_report" type="object" string="Generate Report" class="btn-primary"/>
                    <button name="action_send_report" type="object" string="Send Report"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="report_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="schedule_type"/>
                            <field name="last_run"/>
                            <field name="next_run"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration" name="config">
                            <field name="description"/>
                        </page>
                        <page string="Recipients" name="recipients">
                            <field name="recipient_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Analytics Export Views -->
    <record id="view_analytics_export_tree" model="ir.ui.view">
        <field name="name">analytics.export.tree</field>
        <field name="model">analytics.export</field>
        <field name="arch" type="xml">
            <list string="Exports">
                <field name="name"/>
                <field name="export_format"/>
                <field name="export_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_analytics_dashboard" model="ir.actions.act_window">
        <field name="name">Analytics Dashboards</field>
        <field name="res_model">analytics.dashboard</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first analytics dashboard
            </p>
            <p>
                Design custom dashboards with KPIs, charts, and real-time data visualization.
            </p>
        </field>
    </record>

    <record id="action_analytics_kpi" model="ir.actions.act_window">
        <field name="name">KPIs</field>
        <field name="res_model">analytics.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_analytics_report" model="ir.actions.act_window">
        <field name="name">Analytics Reports</field>
        <field name="res_model">analytics.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_analytics_export" model="ir.actions.act_window">
        <field name="name">Exports</field>
        <field name="res_model">analytics.export</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_analytics_root" name="Analytics" sequence="50" web_icon="advanced_analytics,static/description/icon.png"/>

    <menuitem id="menu_analytics_dashboards" name="Dashboards" parent="menu_analytics_root" sequence="10" action="action_analytics_dashboard"/>

    <menuitem id="menu_analytics_reports" name="Reports" parent="menu_analytics_root" sequence="20" action="action_analytics_report"/>

    <menuitem id="menu_analytics_config" name="Configuration" parent="menu_analytics_root" sequence="100"/>

    <menuitem id="menu_analytics_kpi" name="KPIs" parent="menu_analytics_config" sequence="10" action="action_analytics_kpi"/>

    <menuitem id="menu_analytics_exports" name="Exports" parent="menu_analytics_config" sequence="20" action="action_analytics_export"/>
</odoo>
