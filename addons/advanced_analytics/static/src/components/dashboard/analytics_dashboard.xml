<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="advanced_analytics.AnalyticsDashboard">
        <div class="o_analytics_dashboard h-100">
            <!-- Header -->
            <div class="o_analytics_header d-flex justify-content-between align-items-center p-3 bg-light border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <h2 class="mb-0">
                        <i class="fa fa-line-chart me-2"/>
                        Analytics Dashboard
                    </h2>
                    <t t-if="state.selectedDashboard">
                        <span class="badge bg-primary">
                            <t t-esc="state.selectedDashboard.name"/>
                        </span>
                    </t>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <!-- Date Range -->
                    <div class="input-group input-group-sm" style="width: auto;">
                        <span class="input-group-text">From</span>
                        <input type="date" class="form-control"
                               t-model="state.dateFrom"
                               t-on-change="onDateChange"/>
                        <span class="input-group-text">To</span>
                        <input type="date" class="form-control"
                               t-model="state.dateTo"
                               t-on-change="onDateChange"/>
                    </div>
                    <button class="btn btn-outline-primary btn-sm" t-on-click="refreshDashboard">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="openDashboardConfig"
                            t-if="state.selectedDashboard">
                        <i class="fa fa-cog"/> Configure
                    </button>
                </div>
            </div>

            <!-- Loading State -->
            <div t-if="state.isLoading" class="d-flex justify-content-center align-items-center h-75">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- Error State -->
            <div t-elif="state.error" class="alert alert-danger m-3">
                <i class="fa fa-exclamation-triangle me-2"/>
                <t t-esc="state.error"/>
            </div>

            <!-- No Dashboards -->
            <div t-elif="state.dashboards.length === 0" class="d-flex flex-column justify-content-center align-items-center h-75">
                <i class="fa fa-chart-pie fa-4x text-muted mb-3"/>
                <h4 class="text-muted">No Dashboards Found</h4>
                <p class="text-muted">Create your first analytics dashboard to get started.</p>
                <button class="btn btn-primary" t-on-click="() => this.actionService.doAction('advanced_analytics.action_analytics_dashboard')">
                    <i class="fa fa-plus me-2"/> Create Dashboard
                </button>
            </div>

            <!-- Main Content -->
            <div t-else="" class="o_analytics_content d-flex h-100">
                <!-- Sidebar - Dashboard List -->
                <div class="o_analytics_sidebar border-end bg-white p-3" style="width: 250px; min-width: 250px;">
                    <h5 class="mb-3">Dashboards</h5>
                    <div class="list-group">
                        <t t-foreach="state.dashboards" t-as="dashboard" t-key="dashboard.id">
                            <a href="#"
                               class="list-group-item list-group-item-action d-flex align-items-center"
                               t-att-class="{'active': state.selectedDashboard and state.selectedDashboard.id === dashboard.id}"
                               t-on-click.prevent="() => this.selectDashboard(dashboard)">
                                <i t-att-class="'fa me-2 ' + getDashboardTypeIcon(dashboard.dashboard_type)"/>
                                <span t-esc="dashboard.name"/>
                            </a>
                        </t>
                    </div>
                </div>

                <!-- Main Dashboard Area -->
                <div class="o_analytics_main flex-grow-1 p-4 overflow-auto">
                    <t t-if="state.selectedDashboard">
                        <!-- KPI Cards -->
                        <div class="row g-3 mb-4">
                            <t t-foreach="state.kpis" t-as="kpi" t-key="kpi.id">
                                <div class="col-md-6 col-lg-3">
                                    <div class="card h-100 border-0 shadow-sm"
                                         t-on-click="() => this.openKpiConfig(kpi.id)"
                                         style="cursor: pointer;">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="text-muted mb-2" t-esc="kpi.name"/>
                                                    <h3 class="mb-0" t-esc="kpi.target_value || '—'"/>
                                                </div>
                                                <div t-att-class="'rounded-circle p-2 text-white ' + getKpiColorClass(kpi)">
                                                    <i t-att-class="'fa ' + getKpiIcon(kpi)"/>
                                                </div>
                                            </div>
                                            <div class="mt-2">
                                                <small class="text-muted">
                                                    <t t-esc="kpi.kpi_type"/>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <!-- Add KPI Card -->
                            <div class="col-md-6 col-lg-3" t-if="state.kpis.length &lt; 8">
                                <div class="card h-100 border-dashed bg-light"
                                     style="cursor: pointer; border-style: dashed !important;"
                                     t-on-click="() => this.actionService.doAction('advanced_analytics.action_analytics_kpi')">
                                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-muted">
                                        <i class="fa fa-plus fa-2x mb-2"/>
                                        <span>Add KPI</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Charts Section -->
                        <div class="row g-3">
                            <!-- Main Chart -->
                            <div class="col-lg-8">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-white border-bottom">
                                        <h5 class="mb-0">Performance Overview</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="chart-container" style="height: 300px;">
                                            <canvas id="mainChart"/>
                                            <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                                                <div class="text-center">
                                                    <i class="fa fa-bar-chart fa-3x mb-2"/>
                                                    <p>Chart data will appear here</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Side Charts -->
                            <div class="col-lg-4">
                                <div class="card border-0 shadow-sm mb-3">
                                    <div class="card-header bg-white border-bottom">
                                        <h6 class="mb-0">Distribution</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="chart-container" style="height: 200px;">
                                            <canvas id="pieChart"/>
                                            <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                                                <i class="fa fa-pie-chart fa-2x"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-white border-bottom">
                                        <h6 class="mb-0">Trend</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="chart-container" style="height: 200px;">
                                            <canvas id="trendChart"/>
                                            <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                                                <i class="fa fa-line-chart fa-2x"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Data Table -->
                        <div class="card border-0 shadow-sm mt-4">
                            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Detailed Data</h5>
                                <div>
                                    <button class="btn btn-outline-secondary btn-sm me-2">
                                        <i class="fa fa-download me-1"/> Export
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm">
                                        <i class="fa fa-filter me-1"/> Filter
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Metric</th>
                                                <th>Current Value</th>
                                                <th>Target</th>
                                                <th>Change</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.kpis" t-as="kpi" t-key="'table-' + kpi.id">
                                                <tr>
                                                    <td><t t-esc="kpi.name"/></td>
                                                    <td>—</td>
                                                    <td><t t-esc="kpi.target_value || '—'"/></td>
                                                    <td>—</td>
                                                    <td>
                                                        <span class="badge bg-secondary">Pending</span>
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr t-if="state.kpis.length === 0">
                                                <td colspan="5" class="text-center text-muted py-4">
                                                    No KPIs configured for this dashboard
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
