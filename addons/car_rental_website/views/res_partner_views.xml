<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Form View Extension for Rental -->
    <record id="view_partner_form_rental" model="ir.ui.view">
        <field name="name">res.partner.form.rental</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Car Rental" name="car_rental" groups="car_rental_website.group_rental_user">
                    <group>
                        <group string="Customer Status">
                            <field name="is_rental_customer"/>
                            <field name="rental_verified"/>
                            <field name="email_verified"/>
                            <field name="birthdate"/>
                            <field name="age"/>
                        </group>
                        <group string="Rental Statistics">
                            <field name="total_rentals"/>
                            <field name="total_spent"/>
                            <field name="current_rentals"/>
                        </group>
                    </group>
                    <group string="Driving License">
                        <group>
                            <field name="driving_license_number"/>
                            <field name="driving_license_country_id"/>
                            <field name="driving_license_expiry"/>
                        </group>
                        <group>
                            <field name="driving_license_verified"/>
                            <field name="driving_license_verified_date"/>
                            <field name="driving_license_verified_by"/>
                        </group>
                    </group>
                    <group>
                        <group string="License Images">
                            <field name="driving_license_front" widget="image"/>
                            <field name="driving_license_back" widget="image"/>
                        </group>
                    </group>
                    <group string="Preferences">
                        <field name="preferred_vehicle_type"/>
                        <field name="preferred_insurance_id"/>
                        <field name="preferred_location_id"/>
                    </group>
                    <div class="oe_button_box">
                        <button name="action_verify_license" type="object" string="Verify License"
                                class="btn-primary" invisible="driving_license_verified"/>
                        <button name="action_unverify_license" type="object" string="Unverify License"
                                class="btn-secondary" invisible="not driving_license_verified"/>
                        <button name="send_verification_email" type="object" string="Send Verification Email"
                                class="btn-secondary" invisible="email_verified"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Rental Customers List -->
    <record id="view_partner_rental_customer_list" model="ir.ui.view">
        <field name="name">res.partner.rental.customer.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Rental Customers">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="driving_license_number"/>
                <field name="driving_license_verified"/>
                <field name="email_verified"/>
                <field name="rental_verified"/>
                <field name="total_rentals"/>
            </list>
        </field>
    </record>

    <!-- Rental Customers Action -->
    <record id="action_rental_customers" model="ir.actions.act_window">
        <field name="name">Rental Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_rental_customer', '=', True)]</field>
        <field name="view_id" ref="view_partner_rental_customer_list"/>
        <field name="context">{'default_is_rental_customer': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No rental customers yet
            </p>
        </field>
    </record>

    <!-- Pending License Verification Action -->
    <record id="action_pending_license_verification" model="ir.actions.act_window">
        <field name="name">Pending License Verification</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_rental_customer', '=', True), ('driving_license_verified', '=', False), ('driving_license_front', '!=', False)]</field>
        <field name="view_id" ref="view_partner_rental_customer_list"/>
    </record>
</odoo>
