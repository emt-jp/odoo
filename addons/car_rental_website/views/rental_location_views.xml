<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Location Form View -->
    <record id="view_rental_location_form" model="ir.ui.view">
        <field name="name">rental.location.form</field>
        <field name="model">rental.location</field>
        <field name="arch" type="xml">
            <form string="Rental Location">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="location_type"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address">
                            <group>
                                <group>
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                </group>
                                <group>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                </group>
                            </group>
                        </page>
                        <page string="Operating Hours">
                            <group>
                                <group string="Weekdays">
                                    <field name="monday_open"/>
                                    <field name="monday_close"/>
                                    <field name="tuesday_open"/>
                                    <field name="tuesday_close"/>
                                    <field name="wednesday_open"/>
                                    <field name="wednesday_close"/>
                                    <field name="thursday_open"/>
                                    <field name="thursday_close"/>
                                    <field name="friday_open"/>
                                    <field name="friday_close"/>
                                </group>
                                <group string="Weekend">
                                    <field name="saturday_open"/>
                                    <field name="saturday_close"/>
                                    <field name="sunday_open"/>
                                    <field name="sunday_close"/>
                                </group>
                            </group>
                        </page>
                        <page string="Fees">
                            <group>
                                <group>
                                    <field name="pickup_fee"/>
                                    <field name="dropoff_fee"/>
                                    <field name="different_location_fee"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional information..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Location List View -->
    <record id="view_rental_location_list" model="ir.ui.view">
        <field name="name">rental.location.list</field>
        <field name="model">rental.location</field>
        <field name="arch" type="xml">
            <list string="Rental Locations">
                <field name="name"/>
                <field name="code"/>
                <field name="location_type"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="pickup_fee"/>
                <field name="dropoff_fee"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Location Search View -->
    <record id="view_rental_location_search" model="ir.ui.view">
        <field name="name">rental.location.search</field>
        <field name="model">rental.location</field>
        <field name="arch" type="xml">
            <search string="Search Locations">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_airport" string="Airports" domain="[('location_type', '=', 'airport')]"/>
                <separator/>
                <filter name="group_type" string="Type" context="{'group_by': 'location_type'}"/>
                <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
            </search>
        </field>
    </record>

    <!-- Location Action -->
    <record id="action_rental_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">rental.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_location_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first rental location
            </p>
        </field>
    </record>
</odoo>
