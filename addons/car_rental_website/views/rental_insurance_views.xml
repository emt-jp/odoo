<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Insurance Form View -->
    <record id="view_rental_insurance_form" model="ir.ui.view">
        <field name="name">rental.insurance.form</field>
        <field name="model">rental.insurance</field>
        <field name="arch" type="xml">
            <form string="Insurance Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="daily_rate"/>
                            <field name="deductible"/>
                            <field name="max_coverage"/>
                        </group>
                    </group>
                    <group string="Coverage Options">
                        <group>
                            <field name="collision_damage"/>
                            <field name="theft_protection"/>
                        </group>
                        <group>
                            <field name="personal_accident"/>
                            <field name="roadside_assistance"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="terms"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Insurance List View -->
    <record id="view_rental_insurance_list" model="ir.ui.view">
        <field name="name">rental.insurance.list</field>
        <field name="model">rental.insurance</field>
        <field name="arch" type="xml">
            <list string="Insurance Plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="daily_rate"/>
                <field name="deductible"/>
                <field name="collision_damage"/>
                <field name="theft_protection"/>
                <field name="roadside_assistance"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Insurance Action -->
    <record id="action_rental_insurance" model="ir.actions.act_window">
        <field name="name">Insurance Plans</field>
        <field name="res_model">rental.insurance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first insurance plan
            </p>
        </field>
    </record>
</odoo>
