<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Car List Page -->
    <template id="car_list" name="Car Rental - Available Cars">
        <t t-call="website.layout">
            <div id="wrap" class="o_car_rental">
                <div class="container py-5">
                    <h1 class="mb-4">Available Cars</h1>

                    <!-- Search/Filter Bar -->
                    <div class="card mb-4 shadow-sm">
                        <div class="card-body">
                            <form action="/cars/search" method="GET" class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">Pickup Date</label>
                                    <input type="date" name="pickup_date" class="form-control"
                                           t-att-value="search.get('pickup_date', '')"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Return Date</label>
                                    <input type="date" name="dropoff_date" class="form-control"
                                           t-att-value="search.get('dropoff_date', '')"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Pickup Location</label>
                                    <select name="pickup_location" class="form-select">
                                        <option value="">All Locations</option>
                                        <t t-foreach="locations" t-as="loc">
                                            <option t-att-value="loc.id"
                                                    t-att-selected="str(loc.id) == search.get('pickup_location', '')">
                                                <t t-esc="loc.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fa fa-search"></i> Search
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Filters Sidebar + Car Grid -->
                    <div class="row">
                        <!-- Filters -->
                        <div class="col-lg-3">
                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">Filters</h5>
                                </div>
                                <div class="card-body">
                                    <form action="/cars" method="GET">
                                        <div class="mb-3">
                                            <label class="form-label">Category</label>
                                            <select name="category" class="form-select">
                                                <option value="">All Categories</option>
                                                <t t-foreach="categories" t-as="cat">
                                                    <option t-att-value="cat.id"
                                                            t-att-selected="str(cat.id) == search.get('category', '')">
                                                        <t t-esc="cat.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Transmission</label>
                                            <select name="transmission" class="form-select">
                                                <option value="">All</option>
                                                <option value="automatic" t-att-selected="search.get('transmission') == 'automatic'">Automatic</option>
                                                <option value="manual" t-att-selected="search.get('transmission') == 'manual'">Manual</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Fuel Type</label>
                                            <select name="fuel_type" class="form-select">
                                                <option value="">All</option>
                                                <option value="gasoline" t-att-selected="search.get('fuel_type') == 'gasoline'">Gasoline</option>
                                                <option value="diesel" t-att-selected="search.get('fuel_type') == 'diesel'">Diesel</option>
                                                <option value="hybrid" t-att-selected="search.get('fuel_type') == 'hybrid'">Hybrid</option>
                                                <option value="electric" t-att-selected="search.get('fuel_type') == 'electric'">Electric</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Min Seats</label>
                                            <select name="seats" class="form-select">
                                                <option value="">Any</option>
                                                <option value="2" t-att-selected="search.get('seats') == '2'">2+</option>
                                                <option value="4" t-att-selected="search.get('seats') == '4'">4+</option>
                                                <option value="5" t-att-selected="search.get('seats') == '5'">5+</option>
                                                <option value="7" t-att-selected="search.get('seats') == '7'">7+</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Max Price/Day</label>
                                            <input type="number" name="price_max" class="form-control"
                                                   t-att-value="search.get('price_max', '')" placeholder="Any"/>
                                        </div>
                                        <button type="submit" class="btn btn-outline-primary w-100">Apply Filters</button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Car Grid -->
                        <div class="col-lg-9">
                            <div class="row g-4">
                                <t t-if="not vehicles">
                                    <div class="col-12 text-center py-5">
                                        <i class="fa fa-car fa-3x text-muted mb-3"></i>
                                        <h4>No cars available</h4>
                                        <p class="text-muted">Try adjusting your filters or search criteria.</p>
                                    </div>
                                </t>
                                <t t-foreach="vehicles" t-as="vehicle">
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 shadow-sm vehicle-card">
                                            <t t-if="vehicle.image_128">
                                                <img t-att-src="'/web/image/fleet.vehicle/%s/image_128' % vehicle.id"
                                                     class="card-img-top" style="height: 180px; object-fit: cover;"
                                                     t-att-alt="vehicle.name"/>
                                            </t>
                                            <t t-else="">
                                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                                     style="height: 180px;">
                                                    <i class="fa fa-car fa-3x text-muted"></i>
                                                </div>
                                            </t>
                                            <div class="card-body">
                                                <h5 class="card-title"><t t-esc="vehicle.name"/></h5>
                                                <p class="card-text text-muted small">
                                                    <t t-if="vehicle.brand_id"><t t-esc="vehicle.brand_id.name"/> </t>
                                                    <t t-esc="vehicle.model_id.name"/>
                                                    <t t-if="vehicle.model_year"> (<t t-esc="vehicle.model_year"/>)</t>
                                                </p>
                                                <div class="d-flex flex-wrap gap-2 mb-3">
                                                    <span class="badge bg-light text-dark">
                                                        <i class="fa fa-users"></i> <t t-esc="vehicle.seats"/> seats
                                                    </span>
                                                    <span class="badge bg-light text-dark">
                                                        <i class="fa fa-cog"></i> <t t-esc="vehicle.transmission or 'Auto'"/>
                                                    </span>
                                                    <span class="badge bg-light text-dark">
                                                        <i class="fa fa-gas-pump"></i> <t t-esc="vehicle.fuel_type or 'Gasoline'"/>
                                                    </span>
                                                    <t t-if="vehicle.color">
                                                        <span class="badge bg-light text-dark">
                                                            <i class="fa fa-palette"></i> <t t-esc="vehicle.color"/>
                                                        </span>
                                                    </t>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <span class="h4 text-primary mb-0">
                                                            $<t t-esc="'%.0f' % vehicle.rental_daily_rate"/>
                                                        </span>
                                                        <span class="text-muted">/day</span>
                                                    </div>
                                                    <a t-att-href="'/cars/%s' % vehicle.id" class="btn btn-primary">
                                                        View Details
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Car Detail Page -->
    <template id="car_detail" name="Car Rental - Car Details">
        <t t-call="website.layout">
            <div id="wrap" class="o_car_rental">
                <div class="container py-5">
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/cars">Cars</a></li>
                            <li class="breadcrumb-item active"><t t-esc="vehicle.name"/></li>
                        </ol>
                    </nav>

                    <div class="row">
                        <!-- Vehicle Images -->
                        <div class="col-lg-7">
                            <div class="card shadow-sm mb-4">
                                <t t-if="vehicle.image_128">
                                    <img t-att-src="'/web/image/fleet.vehicle/%s/image_1920' % vehicle.id"
                                         class="card-img-top" style="max-height: 400px; object-fit: cover;"/>
                                </t>
                                <t t-else="">
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                         style="height: 400px;">
                                        <i class="fa fa-car fa-5x text-muted"></i>
                                    </div>
                                </t>
                            </div>

                            <!-- Gallery -->
                            <t t-if="vehicle.image_ids">
                                <div class="row g-2 mb-4">
                                    <t t-foreach="vehicle.image_ids[:6]" t-as="img">
                                        <div class="col-4 col-md-2">
                                            <img t-att-src="'/web/image/fleet.vehicle.image/%s/image' % img.id"
                                                 class="img-fluid rounded" style="height: 80px; object-fit: cover; cursor: pointer;"/>
                                        </div>
                                    </t>
                                </div>
                            </t>

                            <!-- Description -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-body">
                                    <h4>About this car</h4>
                                    <t t-if="vehicle.website_description">
                                        <t t-raw="vehicle.website_description"/>
                                    </t>
                                    <t t-elif="vehicle.description">
                                        <t t-raw="vehicle.description"/>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted">No description available.</p>
                                    </t>
                                </div>
                            </div>

                            <!-- Features -->
                            <t t-if="vehicle.feature_ids">
                                <div class="card shadow-sm mb-4">
                                    <div class="card-body">
                                        <h4>Features</h4>
                                        <div class="row">
                                            <t t-foreach="vehicle.feature_ids" t-as="feature">
                                                <div class="col-6 col-md-4 mb-2">
                                                    <i t-att-class="'fa %s text-primary me-2' % feature.icon"></i>
                                                    <t t-esc="feature.name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- Specifications -->
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <h4>Specifications</h4>
                                    <div class="row">
                                        <div class="col-6">
                                            <ul class="list-unstyled">
                                                <t t-if="vehicle.brand_id">
                                                    <li class="mb-2"><strong>Brand:</strong> <t t-esc="vehicle.brand_id.name"/></li>
                                                </t>
                                                <t t-if="vehicle.model_id">
                                                    <li class="mb-2"><strong>Model:</strong> <t t-esc="vehicle.model_id.name"/></li>
                                                </t>
                                                <t t-if="vehicle.model_year">
                                                    <li class="mb-2"><strong>Year:</strong> <t t-esc="vehicle.model_year"/></li>
                                                </t>
                                                <t t-if="vehicle.color">
                                                    <li class="mb-2"><strong>Color:</strong> <t t-esc="vehicle.color"/></li>
                                                </t>
                                                <li class="mb-2"><strong>Seats:</strong> <t t-esc="vehicle.seats"/></li>
                                                <li class="mb-2"><strong>Doors:</strong> <t t-esc="vehicle.doors"/></li>
                                            </ul>
                                        </div>
                                        <div class="col-6">
                                            <ul class="list-unstyled">
                                                <li class="mb-2"><strong>Transmission:</strong> <t t-esc="vehicle.transmission or 'Automatic'"/></li>
                                                <li class="mb-2"><strong>Fuel Type:</strong> <t t-esc="vehicle.fuel_type or 'Gasoline'"/></li>
                                                <t t-if="vehicle.horsepower">
                                                    <li class="mb-2"><strong>Power:</strong> <t t-esc="vehicle.horsepower"/> HP</li>
                                                </t>
                                                <t t-if="vehicle.co2">
                                                    <li class="mb-2"><strong>CO2:</strong> <t t-esc="vehicle.co2"/> g/km</li>
                                                </t>
                                                <t t-if="vehicle.spec_engine">
                                                    <li class="mb-2"><strong>Engine:</strong> <t t-esc="vehicle.spec_engine"/></li>
                                                </t>
                                                <t t-if="vehicle.spec_trunk_capacity">
                                                    <li class="mb-2"><strong>Trunk:</strong> <t t-esc="vehicle.spec_trunk_capacity"/></li>
                                                </t>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Booking Card -->
                        <div class="col-lg-5">
                            <div class="card shadow sticky-top" style="top: 20px;">
                                <div class="card-body">
                                    <h3 class="card-title"><t t-esc="vehicle.name"/></h3>
                                    <div class="mb-3">
                                        <span class="h2 text-primary">$<t t-esc="'%.0f' % vehicle.rental_daily_rate"/></span>
                                        <span class="text-muted">/day</span>
                                    </div>

                                    <t t-if="vehicle.rental_weekly_rate">
                                        <p class="small text-muted mb-1">
                                            Weekly rate (7+ days): $<t t-esc="'%.0f' % vehicle.rental_weekly_rate"/>/day
                                        </p>
                                    </t>
                                    <t t-if="vehicle.rental_monthly_rate">
                                        <p class="small text-muted mb-3">
                                            Monthly rate (30+ days): $<t t-esc="'%.0f' % vehicle.rental_monthly_rate"/>/day
                                        </p>
                                    </t>

                                    <hr/>

                                    <a t-att-href="'/cars/%s/book' % vehicle.id" class="btn btn-primary btn-lg w-100 mb-3">
                                        <i class="fa fa-calendar-check"></i> Book Now
                                    </a>

                                    <div class="small text-muted">
                                        <p class="mb-1"><i class="fa fa-check text-success me-2"></i>Free cancellation up to 48h before</p>
                                        <p class="mb-1"><i class="fa fa-check text-success me-2"></i>No hidden fees</p>
                                        <p class="mb-1"><i class="fa fa-check text-success me-2"></i>24/7 customer support</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Booking Form Page -->
    <template id="booking_form" name="Car Rental - Booking Form">
        <t t-call="website.layout">
            <div id="wrap" class="o_car_rental">
                <div class="container py-5">
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/cars">Cars</a></li>
                            <li class="breadcrumb-item"><a t-att-href="'/cars/%s' % vehicle.id"><t t-esc="vehicle.name"/></a></li>
                            <li class="breadcrumb-item active">Book</li>
                        </ol>
                    </nav>

                    <h1 class="mb-4">Book <t t-esc="vehicle.name"/></h1>

                    <form action="/cars/book/submit" method="POST" class="row">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="vehicle_id" t-att-value="vehicle.id"/>

                        <div class="col-lg-8">
                            <!-- Dates and Location -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="fa fa-calendar me-2"></i>Dates &amp; Locations</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Pickup Date *</label>
                                            <input type="date" name="pickup_date" class="form-control" required="required"
                                                   t-att-value="pickup_date" t-att-min="datetime.date.today().isoformat()"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Pickup Time</label>
                                            <input type="time" name="pickup_time" class="form-control" value="10:00"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Return Date *</label>
                                            <input type="date" name="dropoff_date" class="form-control" required="required"
                                                   t-att-value="dropoff_date"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Return Time</label>
                                            <input type="time" name="dropoff_time" class="form-control" value="10:00"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Pickup Location *</label>
                                            <select name="pickup_location" class="form-select" required="required">
                                                <option value="">Select location</option>
                                                <t t-foreach="locations" t-as="loc">
                                                    <option t-att-value="loc.id">
                                                        <t t-esc="loc.name"/>
                                                        <t t-if="loc.pickup_fee"> (+$<t t-esc="'%.0f' % loc.pickup_fee"/>)</t>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Return Location *</label>
                                            <select name="dropoff_location" class="form-select" required="required">
                                                <option value="">Select location</option>
                                                <t t-foreach="locations" t-as="loc">
                                                    <option t-att-value="loc.id">
                                                        <t t-esc="loc.name"/>
                                                        <t t-if="loc.dropoff_fee"> (+$<t t-esc="'%.0f' % loc.dropoff_fee"/>)</t>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Customer Information -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="fa fa-user me-2"></i>Your Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Full Name *</label>
                                            <input type="text" name="name" class="form-control" required="required"
                                                   t-att-value="request.env.user.partner_id.name if not request.env.user._is_public() else ''"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Email *</label>
                                            <input type="email" name="email" class="form-control" required="required"
                                                   t-att-value="request.env.user.partner_id.email if not request.env.user._is_public() else ''"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Phone *</label>
                                            <input type="tel" name="phone" class="form-control" required="required"
                                                   t-att-value="request.env.user.partner_id.phone if not request.env.user._is_public() else ''"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Insurance -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="fa fa-shield-alt me-2"></i>Insurance</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <t t-foreach="insurances" t-as="ins">
                                            <div class="col-md-4">
                                                <div class="card h-100">
                                                    <div class="card-body">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="insurance"
                                                                   t-att-value="ins.id" t-att-id="'ins_%s' % ins.id"
                                                                   t-att-checked="ins.code == 'basic'"/>
                                                            <label class="form-check-label" t-att-for="'ins_%s' % ins.id">
                                                                <strong><t t-esc="ins.name"/></strong>
                                                            </label>
                                                        </div>
                                                        <p class="text-primary mb-1">
                                                            <t t-if="ins.daily_rate > 0">
                                                                $<t t-esc="'%.0f' % ins.daily_rate"/>/day
                                                            </t>
                                                            <t t-else="">Free</t>
                                                        </p>
                                                        <p class="small text-muted mb-0"><t t-esc="ins.description or ''"/></p>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- Extras -->
                            <t t-if="extras">
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header">
                                        <h5 class="mb-0"><i class="fa fa-plus-circle me-2"></i>Extras</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-3">
                                            <t t-foreach="extras" t-as="extra">
                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <input class="form-check-input extra-checkbox" type="checkbox"
                                                               name="extras" t-att-value="extra.id"
                                                               t-att-id="'extra_%s' % extra.id"/>
                                                        <label class="form-check-label" t-att-for="'extra_%s' % extra.id">
                                                            <i t-att-class="'fa %s me-2' % extra.icon"></i>
                                                            <strong><t t-esc="extra.name"/></strong>
                                                            <span class="text-primary ms-2">
                                                                $<t t-esc="'%.0f' % extra.price"/>
                                                                <t t-if="extra.price_type == 'per_day'">/day</t>
                                                                <t t-elif="extra.price_type == 'per_rental'">/rental</t>
                                                            </span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- Notes -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="fa fa-comment me-2"></i>Additional Notes</h5>
                                </div>
                                <div class="card-body">
                                    <textarea name="notes" class="form-control" rows="3"
                                              placeholder="Any special requests or notes..."></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Summary Sidebar -->
                        <div class="col-lg-4">
                            <div class="card shadow sticky-top" style="top: 20px;">
                                <div class="card-body">
                                    <h5 class="card-title">Booking Summary</h5>
                                    <div class="d-flex align-items-center mb-3">
                                        <t t-if="vehicle.image_128">
                                            <img t-att-src="'/web/image/fleet.vehicle/%s/image_128' % vehicle.id"
                                                 class="rounded me-3" style="width: 80px; height: 60px; object-fit: cover;"/>
                                        </t>
                                        <div>
                                            <strong><t t-esc="vehicle.name"/></strong>
                                        </div>
                                    </div>

                                    <hr/>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Daily rate:</span>
                                        <span>$<t t-esc="'%.0f' % vehicle.rental_daily_rate"/></span>
                                    </div>

                                    <p class="small text-muted mb-3">
                                        Final price will be calculated based on your selected dates and options.
                                    </p>

                                    <button type="submit" class="btn btn-primary btn-lg w-100">
                                        Continue to Checkout
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- Booking Checkout Page -->
    <template id="booking_checkout" name="Car Rental - Checkout">
        <t t-call="website.layout">
            <div id="wrap" class="o_car_rental">
                <div class="container py-5">
                    <h1 class="mb-4">Checkout</h1>

                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">Booking Details</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6>Vehicle</h6>
                                            <p><t t-esc="booking.vehicle_name"/></p>

                                            <h6>Customer</h6>
                                            <p>
                                                <t t-esc="booking.partner_id.name"/><br/>
                                                <t t-esc="booking.partner_email"/><br/>
                                                <t t-esc="booking.partner_phone"/>
                                            </p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6>Pickup</h6>
                                            <p>
                                                <strong><t t-esc="booking.pickup_date.strftime('%B %d, %Y %H:%M')"/></strong><br/>
                                                <t t-esc="booking.pickup_location_id.name"/>
                                            </p>

                                            <h6>Return</h6>
                                            <p>
                                                <strong><t t-esc="booking.dropoff_date.strftime('%B %d, %Y %H:%M')"/></strong><br/>
                                                <t t-esc="booking.dropoff_location_id.name"/>
                                            </p>
                                        </div>
                                    </div>

                                    <t t-if="booking.insurance_id">
                                        <h6>Insurance</h6>
                                        <p><t t-esc="booking.insurance_id.name"/></p>
                                    </t>

                                    <t t-if="booking.extra_line_ids">
                                        <h6>Extras</h6>
                                        <ul>
                                            <t t-foreach="booking.extra_line_ids" t-as="line">
                                                <li><t t-esc="line.extra_id.name"/> x<t t-esc="line.quantity"/></li>
                                            </t>
                                        </ul>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card shadow">
                                <div class="card-body">
                                    <h5 class="card-title">Price Summary</h5>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Vehicle (<t t-esc="booking.rental_days"/> days)</span>
                                        <span>$<t t-esc="'%.2f' % booking.vehicle_total"/></span>
                                    </div>

                                    <t t-if="booking.insurance_total">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Insurance</span>
                                            <span>$<t t-esc="'%.2f' % booking.insurance_total"/></span>
                                        </div>
                                    </t>

                                    <t t-if="booking.extras_total">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Extras</span>
                                            <span>$<t t-esc="'%.2f' % booking.extras_total"/></span>
                                        </div>
                                    </t>

                                    <t t-if="booking.location_fee">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Location fees</span>
                                            <span>$<t t-esc="'%.2f' % booking.location_fee"/></span>
                                        </div>
                                    </t>

                                    <hr/>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal</span>
                                        <span>$<t t-esc="'%.2f' % booking.subtotal"/></span>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tax (<t t-esc="'%.0f' % booking.tax_rate"/>%)</span>
                                        <span>$<t t-esc="'%.2f' % booking.tax_amount"/></span>
                                    </div>

                                    <hr/>

                                    <div class="d-flex justify-content-between mb-4">
                                        <strong class="h5 mb-0">Total</strong>
                                        <strong class="h5 mb-0 text-primary">$<t t-esc="'%.2f' % booking.total_amount"/></strong>
                                    </div>

                                    <form t-att-action="'/cars/book/pay/%s?access_token=%s' % (booking.id, booking.access_token)" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <t t-if="stripe_enabled">
                                            <input type="hidden" name="payment_method" value="stripe"/>
                                            <button type="submit" class="btn btn-primary btn-lg w-100 mb-2">
                                                <i class="fa fa-credit-card me-2"></i>Pay with Card
                                            </button>
                                        </t>
                                        <t t-else="">
                                            <input type="hidden" name="payment_method" value="cash"/>
                                            <button type="submit" class="btn btn-primary btn-lg w-100 mb-2">
                                                <i class="fa fa-check me-2"></i>Confirm Booking
                                            </button>
                                            <p class="small text-muted text-center">Payment at pickup location</p>
                                        </t>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Payment Success -->
    <template id="payment_success" name="Car Rental - Payment Success">
        <t t-call="website.layout">
            <div id="wrap" class="o_car_rental">
                <div class="container py-5 text-center">
                    <div class="mb-4">
                        <i class="fa fa-check-circle text-success" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="mb-3">Booking Confirmed!</h1>
                    <p class="lead text-muted mb-4">
                        Thank you for your booking. A confirmation email has been sent to your email address.
                    </p>

                    <t t-if="booking">
                        <div class="card shadow-sm mx-auto" style="max-width: 500px;">
                            <div class="card-body">
                                <h5>Booking Reference: <t t-esc="booking.name"/></h5>
                                <p class="mb-1"><strong>Vehicle:</strong> <t t-esc="booking.vehicle_name"/></p>
                                <p class="mb-1"><strong>Pickup:</strong> <t t-esc="booking.pickup_date.strftime('%B %d, %Y %H:%M')"/></p>
                                <p class="mb-3"><strong>Location:</strong> <t t-esc="booking.pickup_location_id.name"/></p>
                                <a t-att-href="'/my/rental/%s?access_token=%s' % (booking.id, booking.access_token)"
                                   class="btn btn-primary">View Booking Details</a>
                            </div>
                        </div>
                    </t>

                    <div class="mt-4">
                        <a href="/cars" class="btn btn-outline-secondary">Browse More Cars</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Payment Cancel -->
    <template id="payment_cancel" name="Car Rental - Payment Cancelled">
        <t t-call="website.layout">
            <div id="wrap" class="o_car_rental">
                <div class="container py-5 text-center">
                    <div class="mb-4">
                        <i class="fa fa-times-circle text-warning" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="mb-3">Payment Cancelled</h1>
                    <p class="lead text-muted mb-4">
                        Your payment was cancelled. Your booking has not been confirmed.
                    </p>

                    <t t-if="booking">
                        <a t-att-href="'/cars/book/checkout/%s?access_token=%s' % (booking.id, booking.access_token)"
                           class="btn btn-primary">Try Again</a>
                    </t>

                    <div class="mt-3">
                        <a href="/cars" class="btn btn-outline-secondary">Browse Cars</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Booking Error -->
    <template id="booking_error" name="Car Rental - Booking Error">
        <t t-call="website.layout">
            <div id="wrap" class="o_car_rental">
                <div class="container py-5 text-center">
                    <div class="mb-4">
                        <i class="fa fa-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="mb-3">Booking Error</h1>
                    <p class="lead text-muted mb-4">
                        <t t-esc="error"/>
                    </p>
                    <a href="/cars" class="btn btn-primary">Browse Cars</a>
                </div>
            </div>
        </t>
    </template>

    <!-- Email Verified -->
    <template id="email_verified" name="Car Rental - Email Verified">
        <t t-call="website.layout">
            <div id="wrap" class="o_car_rental">
                <div class="container py-5 text-center">
                    <t t-if="success">
                        <div class="mb-4">
                            <i class="fa fa-check-circle text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h1 class="mb-3">Email Verified!</h1>
                        <p class="lead text-muted mb-4">
                            Your email has been verified successfully. You can now rent cars.
                        </p>
                    </t>
                    <t t-else="">
                        <div class="mb-4">
                            <i class="fa fa-times-circle text-danger" style="font-size: 5rem;"></i>
                        </div>
                        <h1 class="mb-3">Verification Failed</h1>
                        <p class="lead text-muted mb-4">
                            The verification link is invalid or has expired.
                        </p>
                    </t>
                    <a href="/cars" class="btn btn-primary">Browse Cars</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
