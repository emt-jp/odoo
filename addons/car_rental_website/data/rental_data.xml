        <record id="location_haneda" model="rental.location">
            <field name="name">Haneda Airport</field>
            <field name="code">HND01</field>
            <field name="location_type">airport</field>
            <field name="street">Haneda Airport, Terminal 2</field>
            <field name="city">Tokyo</field>
            <field name="country_id" ref="base.jp"/>
            <field name="phone">+81-3-5757-8910</field>
            <field name="email">haneda@carrental.com</field>
            <field name="monday_open">5.0</field>
            <field name="monday_close">23.0</field>
            <field name="tuesday_open">5.0</field>
            <field name="tuesday_close">23.0</field>
            <field name="wednesday_open">5.0</field>
            <field name="wednesday_close">23.0</field>
            <field name="thursday_open">5.0</field>
            <field name="thursday_close">23.0</field>
            <field name="friday_open">5.0</field>
            <field name="friday_close">23.0</field>
            <field name="saturday_open">5.0</field>
            <field name="saturday_close">23.0</field>
            <field name="sunday_open">5.0</field>
            <field name="sunday_close">23.0</field>
            <field name="pickup_fee">15</field>
            <field name="dropoff_fee">15</field>
            <field name="different_location_fee">70</field>
        </record>

        <!-- Vehicle Features -->
        <record id="feature_ac" model="fleet.vehicle.feature">
            <field name="name">Air Conditioning</field>
            <field name="code">AC</field>
            <field name="icon">fa-snowflake</field>
            <field name="category">comfort</field>
        </record>

        <record id="feature_bluetooth" model="fleet.vehicle.feature">
            <field name="name">Bluetooth</field>
            <field name="code">BLUETOOTH</field>
            <field name="icon">fa-bluetooth-b</field>
            <field name="category">technology</field>
        </record>

        <record id="feature_usb" model="fleet.vehicle.feature">
            <field name="name">USB Charging</field>
            <field name="code">USB</field>
            <field name="icon">fa-usb</field>
            <field name="category">technology</field>
        </record>

        <record id="feature_cruise" model="fleet.vehicle.feature">
            <field name="name">Cruise Control</field>
            <field name="code">CRUISE</field>
            <field name="icon">fa-tachometer-alt</field>
            <field name="category">comfort</field>
        </record>

        <record id="feature_camera" model="fleet.vehicle.feature">
            <field name="name">Backup Camera</field>
            <field name="code">CAMERA</field>
            <field name="icon">fa-camera</field>
            <field name="category">safety</field>
        </record>

        <record id="feature_sensors" model="fleet.vehicle.feature">
            <field name="name">Parking Sensors</field>
            <field name="code">SENSORS</field>
            <field name="icon">fa-satellite-dish</field>
            <field name="category">safety</field>
        </record>

        <record id="feature_nav" model="fleet.vehicle.feature">
            <field name="name">Built-in Navigation</field>
            <field name="code">NAV</field>
            <field name="icon">fa-map-marked-alt</field>
            <field name="category">technology</field>
        </record>

        <record id="feature_leather" model="fleet.vehicle.feature">
            <field name="name">Leather Seats</field>
            <field name="code">LEATHER</field>
            <field name="icon">fa-couch</field>
            <field name="category">comfort</field>
        </record>

        <record id="feature_sunroof" model="fleet.vehicle.feature">
            <field name="name">Sunroof</field>
            <field name="code">SUNROOF</field>
            <field name="icon">fa-sun</field>
