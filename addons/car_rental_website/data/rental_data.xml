            <field name="location_type">airport</field>
            <field name="street">Narita International Airport, Terminal 1</field>
            <field name="city">Narita</field>
            <field name="country_id" ref="base.jp"/>
            <field name="phone">+81-476-34-5678</field>
            <field name="email">narita@carrental.com</field>
            <field name="monday_open">6.0</field>
            <field name="monday_close">22.0</field>
            <field name="tuesday_open">6.0</field>
            <field name="tuesday_close">22.0</field>
            <field name="wednesday_open">6.0</field>
            <field name="wednesday_close">22.0</field>
