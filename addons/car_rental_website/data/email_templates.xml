<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- New Booking Email - Sent when booking is created -->
        <record id="email_template_booking_new" model="mail.template">
            <field name="name">Car Rental: New Booking Received</field>
            <field name="model_id" ref="model_rental_booking"/>
            <field name="subject">New Booking Received - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #3498db; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Booking Received</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px;">
                <p style="font-size: 16px;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                <p style="font-size: 16px;">Thank you for your booking request! We have received your reservation and will review it shortly.</p>

                <div style="background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <h3 style="color: #2c3e50; margin-top: 0;">Booking Details</h3>
                    <table style="width: 100%;">
                        <tr><td style="padding: 8px 0;"><strong>Reference:</strong></td><td><t t-out="object.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Vehicle:</strong></td><td><t t-out="object.vehicle_name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Pickup:</strong></td><td><t t-out="object.pickup_date.strftime('%Y-%m-%d %H:%M')"/> at <t t-out="object.pickup_location_id.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Return:</strong></td><td><t t-out="object.dropoff_date.strftime('%Y-%m-%d %H:%M')"/> at <t t-out="object.dropoff_location_id.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Total:</strong></td><td style="font-size: 18px; color: #27ae60;"><t t-out="object.currency_id.symbol"/><t t-out="'%.2f' % object.total_amount"/></td></tr>
                    </table>
                </div>

                <div style="background: #fff3cd; border-radius: 8px; padding: 15px; margin: 20px 0;">
                    <p style="margin: 0; color: #856404;"><strong>Status:</strong> Awaiting Confirmation</p>
                    <p style="margin: 10px 0 0 0; color: #856404;">We will send you another email once your booking is confirmed.</p>
                </div>

                <div style="text-align: center; margin: 30px 0;">
                    <a href="/my/rental/{{ object.id }}?access_token={{ object.access_token }}" style="background: #3498db; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;">View Booking</a>
                </div>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- Booking Confirmed Email -->
        <record id="email_template_booking_confirmed" model="mail.template">
            <field name="name">Car Rental: Booking Confirmed</field>
            <field name="model_id" ref="model_rental_booking"/>
            <field name="subject">Booking Confirmed - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #27ae60; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Booking Confirmed!</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px;">
                <p style="font-size: 16px;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                <p style="font-size: 16px;">Great news! Your booking has been confirmed. Please proceed with payment to secure your reservation.</p>

                <div style="background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <h3 style="color: #2c3e50; margin-top: 0;">Booking Details</h3>
                    <table style="width: 100%;">
                        <tr><td style="padding: 8px 0;"><strong>Reference:</strong></td><td><t t-out="object.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Vehicle:</strong></td><td><t t-out="object.vehicle_name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Pickup:</strong></td><td><t t-out="object.pickup_date.strftime('%Y-%m-%d %H:%M')"/> at <t t-out="object.pickup_location_id.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Return:</strong></td><td><t t-out="object.dropoff_date.strftime('%Y-%m-%d %H:%M')"/> at <t t-out="object.dropoff_location_id.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Total:</strong></td><td style="font-size: 18px; color: #27ae60;"><t t-out="object.currency_id.symbol"/><t t-out="'%.2f' % object.total_amount"/></td></tr>
                    </table>
                </div>

                <div style="background: #d4edda; border-radius: 8px; padding: 15px; margin: 20px 0;">
                    <p style="margin: 0; color: #155724;"><strong>Next Step:</strong> Complete Payment</p>
                </div>

                <div style="text-align: center; margin: 30px 0;">
                    <a href="/my/rental/{{ object.id }}?access_token={{ object.access_token }}" style="background: #27ae60; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;">Pay Now</a>
                </div>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- Booking Paid Email -->
        <record id="email_template_booking_paid" model="mail.template">
            <field name="name">Car Rental: Payment Received</field>
            <field name="model_id" ref="model_rental_booking"/>
            <field name="subject">Payment Received - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #2ecc71; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Payment Confirmed!</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px;">
                <p style="font-size: 16px;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                <p style="font-size: 16px;">Your payment has been received successfully. Your rental is now fully booked!</p>

                <div style="background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <h3 style="color: #2c3e50; margin-top: 0;">Payment Receipt</h3>
                    <table style="width: 100%;">
                        <tr><td style="padding: 8px 0;"><strong>Reference:</strong></td><td><t t-out="object.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Amount Paid:</strong></td><td style="font-size: 18px; color: #27ae60;"><t t-out="object.currency_id.symbol"/><t t-out="'%.2f' % object.amount_paid"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Vehicle:</strong></td><td><t t-out="object.vehicle_name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Pickup:</strong></td><td><t t-out="object.pickup_date.strftime('%Y-%m-%d %H:%M')"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Location:</strong></td><td><t t-out="object.pickup_location_id.name"/></td></tr>
                    </table>
                </div>

                <h4 style="color: #2c3e50;">What to bring at pickup:</h4>
                <ul style="color: #555;">
                    <li>Valid driving license</li>
                    <li>Government-issued ID</li>
                    <li>Credit card for security deposit</li>
                </ul>

                <div style="text-align: center; margin: 30px 0;">
                    <a href="/my/rental/{{ object.id }}?access_token={{ object.access_token }}" style="background: #3498db; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;">View Booking</a>
                </div>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- Rental Started Email -->
        <record id="email_template_booking_started" model="mail.template">
            <field name="name">Car Rental: Rental Started</field>
            <field name="model_id" ref="model_rental_booking"/>
            <field name="subject">Your Rental Has Started - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #9b59b6; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Rental In Progress</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px;">
                <p style="font-size: 16px;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                <p style="font-size: 16px;">Enjoy your ride! Your rental is now in progress.</p>

                <div style="background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <h3 style="color: #2c3e50; margin-top: 0;">Rental Details</h3>
                    <table style="width: 100%;">
                        <tr><td style="padding: 8px 0;"><strong>Vehicle:</strong></td><td><t t-out="object.vehicle_name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Return Date:</strong></td><td><t t-out="object.dropoff_date.strftime('%Y-%m-%d %H:%M')"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Return Location:</strong></td><td><t t-out="object.dropoff_location_id.name"/></td></tr>
                    </table>
                </div>

                <h4 style="color: #2c3e50;">Important Reminders:</h4>
                <ul style="color: #555;">
                    <li>Return the car with the same fuel level</li>
                    <li>Check for any damage before returning</li>
                    <li>Keep all receipts for tolls and parking</li>
                    <li>Contact us immediately in case of emergency</li>
                </ul>

                <p style="font-size: 14px; color: #777; margin-top: 30px;">
                    Have a safe and pleasant journey!
                </p>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- Booking Completed Email (Thank You) -->
        <record id="email_template_booking_completed" model="mail.template">
            <field name="name">Car Rental: Thank You</field>
            <field name="model_id" ref="model_rental_booking"/>
            <field name="subject">Thank You for Renting with Us - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #1abc9c; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Thank You!</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px;">
                <p style="font-size: 16px;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                <p style="font-size: 16px;">Thank you for choosing us for your car rental! We hope you had a great experience.</p>

                <div style="background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <h3 style="color: #2c3e50; margin-top: 0;">Rental Summary</h3>
                    <table style="width: 100%;">
                        <tr><td style="padding: 8px 0;"><strong>Reference:</strong></td><td><t t-out="object.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Vehicle:</strong></td><td><t t-out="object.vehicle_name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Duration:</strong></td><td><t t-out="object.rental_days"/> day(s)</td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Total Paid:</strong></td><td style="font-size: 18px; color: #27ae60;"><t t-out="object.currency_id.symbol"/><t t-out="'%.2f' % object.amount_paid"/></td></tr>
                    </table>
                </div>

                <div style="background: #e8f8f5; border-radius: 8px; padding: 20px; margin: 20px 0; text-align: center;">
                    <h3 style="color: #1abc9c; margin-top: 0;">We'd Love Your Feedback!</h3>
                    <p>Your opinion matters to us. Please take a moment to share your experience.</p>
                </div>

                <p style="font-size: 14px; color: #777; margin-top: 30px;">
                    We look forward to serving you again!
                </p>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- Survey Email -->
        <record id="email_template_booking_survey" model="mail.template">
            <field name="name">Car Rental: Feedback Survey</field>
            <field name="model_id" ref="model_rental_booking"/>
            <field name="subject">How was your rental experience? - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #f39c12; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Share Your Feedback</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px; text-align: center;">
                <p style="font-size: 16px;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                <p style="font-size: 16px;">We hope you enjoyed your recent car rental experience with us!</p>
                <p style="font-size: 16px;">Would you mind taking a minute to rate your experience?</p>

                <div style="margin: 30px 0;">
                    <h3 style="color: #2c3e50;">How would you rate your experience?</h3>
                    <table style="margin: 0 auto;">
                        <tr>
                            <td style="padding: 10px; text-align: center;">
                                <a href="/rental/feedback/{{ object.id }}/5?token={{ object.access_token }}" style="text-decoration: none; font-size: 40px;">⭐</a>
                                <br/><span style="font-size: 12px;">Excellent</span>
                            </td>
                            <td style="padding: 10px; text-align: center;">
                                <a href="/rental/feedback/{{ object.id }}/4?token={{ object.access_token }}" style="text-decoration: none; font-size: 40px;">⭐</a>
                                <br/><span style="font-size: 12px;">Good</span>
                            </td>
                            <td style="padding: 10px; text-align: center;">
                                <a href="/rental/feedback/{{ object.id }}/3?token={{ object.access_token }}" style="text-decoration: none; font-size: 40px;">⭐</a>
                                <br/><span style="font-size: 12px;">OK</span>
                            </td>
                            <td style="padding: 10px; text-align: center;">
                                <a href="/rental/feedback/{{ object.id }}/2?token={{ object.access_token }}" style="text-decoration: none; font-size: 40px;">⭐</a>
                                <br/><span style="font-size: 12px;">Poor</span>
                            </td>
                            <td style="padding: 10px; text-align: center;">
                                <a href="/rental/feedback/{{ object.id }}/1?token={{ object.access_token }}" style="text-decoration: none; font-size: 40px;">⭐</a>
                                <br/><span style="font-size: 12px;">Bad</span>
                            </td>
                        </tr>
                    </table>
                </div>

                <p style="font-size: 14px; color: #777;">
                    Your feedback helps us improve our service for everyone.
                </p>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- Booking Cancelled Email -->
        <record id="email_template_booking_cancelled" model="mail.template">
            <field name="name">Car Rental: Booking Cancelled</field>
            <field name="model_id" ref="model_rental_booking"/>
            <field name="subject">Booking Cancelled - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #e74c3c; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Booking Cancelled</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px;">
                <p style="font-size: 16px;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                <p style="font-size: 16px;">Your booking has been cancelled.</p>

                <div style="background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <h3 style="color: #2c3e50; margin-top: 0;">Cancelled Booking Details</h3>
                    <table style="width: 100%;">
                        <tr><td style="padding: 8px 0;"><strong>Reference:</strong></td><td><t t-out="object.name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Vehicle:</strong></td><td><t t-out="object.vehicle_name"/></td></tr>
                        <tr><td style="padding: 8px 0;"><strong>Original Dates:</strong></td><td><t t-out="object.pickup_date.strftime('%Y-%m-%d')"/> - <t t-out="object.dropoff_date.strftime('%Y-%m-%d')"/></td></tr>
                    </table>
                </div>

                <t t-if="object.refund_amount > 0">
                    <div style="background: #d4edda; border-radius: 8px; padding: 15px; margin: 20px 0;">
                        <p style="margin: 0; color: #155724;"><strong>Refund Amount:</strong> <t t-out="object.currency_id.symbol"/><t t-out="'%.2f' % object.refund_amount"/></p>
                        <p style="margin: 10px 0 0 0; color: #155724;">The refund will be processed to your original payment method within 5-10 business days.</p>
                    </div>
                </t>

                <p style="font-size: 14px; color: #777; margin-top: 30px;">
                    We hope to serve you in the future. If you have any questions, please contact us.
                </p>

                <div style="text-align: center; margin: 30px 0;">
                    <a href="/cars" style="background: #3498db; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;">Book Again</a>
                </div>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- Email Verification -->
        <record id="email_template_verify_email" model="mail.template">
            <field name="name">Car Rental: Verify Email</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Verify Your Email Address</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #3498db; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Verify Your Email</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px; text-align: center;">
                <p style="font-size: 16px;">Hi <t t-out="object.name or 'there'"/>,</p>
                <p style="font-size: 16px;">Please click the button below to verify your email address.</p>
                <div style="margin: 30px 0;">
                    <a href="/rental/verify-email/{{ object.email_verification_token }}" style="background: #27ae60; color: white; padding: 15px 40px; text-decoration: none; border-radius: 5px; display: inline-block; font-size: 16px;">Verify Email</a>
                </div>
                <p style="font-size: 14px; color: #777;">If you didn't request this verification, you can safely ignore this email.</p>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

        <!-- Pickup Reminder Email -->
        <record id="email_template_booking_reminder" model="mail.template">
            <field name="name">Car Rental: Pickup Reminder</field>
            <field name="model_id" ref="model_rental_booking"/>
            <field name="subject">Reminder: Your Car Rental Pickup Tomorrow - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_email }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="padding: 20px; background: #f39c12; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">Pickup Reminder</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px;">
                <p style="font-size: 16px;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                <p style="font-size: 16px;">This is a friendly reminder that your car rental pickup is scheduled for tomorrow.</p>
                <div style="background: #fff3cd; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <h3 style="color: #856404; margin-top: 0;">Pickup Information</h3>
                    <p><strong>Date &amp; Time:</strong> <t t-out="object.pickup_date.strftime('%Y-%m-%d %H:%M')"/></p>
                    <p><strong>Location:</strong> <t t-out="object.pickup_location_id.name"/></p>
                    <p><strong>Vehicle:</strong> <t t-out="object.vehicle_name"/></p>
                </div>
                <h4 style="color: #2c3e50;">What to bring:</h4>
                <ul>
                    <li>Valid driving license</li>
                    <li>Government-issued ID</li>
                    <li>Credit card for security deposit</li>
                </ul>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>
    </data>
</odoo>
