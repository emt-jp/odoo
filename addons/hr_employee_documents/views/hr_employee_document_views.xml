<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_document_view_form" model="ir.ui.view">
        <field name="name">hr.employee.document.form</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <form string="Employee Document">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="document_type_id"/>
                            <field name="document_number"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="has_expiry" invisible="1"/>
                            <field name="expiry_date" invisible="not has_expiry"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_employee_document_view_list" model="ir.ui.view">
        <field name="name">hr.employee.document.list</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <list string="Employee Documents" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'valid'"
                    decoration-warning="state == 'expiring'"
                    decoration-danger="state == 'expired'"
                />
            </list>
        </field>
    </record>

    <record id="hr_employee_document_view_search" model="ir.ui.view">
        <field name="name">hr.employee.document.search</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <separator/>
                <filter name="expiring" string="Expiring Soon" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="valid" string="Valid" domain="[('state', '=', 'valid')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_employee_document_action" model="ir.actions.act_window">
        <field name="name">Employee Documents</field>
        <field name="res_model">hr.employee.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_employee_document_view_search"/>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

    <record id="hr_employee_document_action_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Documents</field>
        <field name="res_model">hr.employee.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['expiring', 'expired'])]</field>
    </record>
</odoo>
