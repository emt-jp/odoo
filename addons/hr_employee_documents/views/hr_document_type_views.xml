<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_document_type_view_form" model="ir.ui.view">
        <field name="name">hr.document.type.form</field>
        <field name="model">hr.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="has_expiry"/>
                            <field name="expiry_warning_days" invisible="not has_expiry"/>
                            <field name="required_for_onboarding"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Description or notes about this document type..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_document_type_view_list" model="ir.ui.view">
        <field name="name">hr.document.type.list</field>
        <field name="model">hr.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="has_expiry"/>
                <field name="expiry_warning_days"/>
                <field name="required_for_onboarding"/>
            </list>
        </field>
    </record>

    <record id="hr_document_type_action" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">hr.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
